-- Co-authored with CoCo
-- FK: BUDGET_ITEM_DK → ERP_BUDGET_ITEM (동일 MD5 식). Snowflake LATERAL VALUES 상관제약 회피 위해 CTE+UNION.
WITH B AS (
  SELECT
    MD5(COALESCE(TO_VARCHAR(YEAR),'')||'|'||COALESCE(INCOME_EXPS_DIV_NM,'')||'|'||COALESCE(BDGT_UNIT_NM,'')||'|'||
        COALESCE(JANG_NM,'')||'|'||COALESCE(KWAN_NM,'')||'|'||COALESCE(HANG_NM,'')||'|'||
        COALESCE(MOK_NM,'')||'|'||COALESCE(DTL_ITEM_NM,'')||'|'||COALESCE(SUBDTL_ITEM_NM,'')||'|'||COALESCE(FUND_SOURCE_NM,'')) AS BUDGET_ITEM_DK,
    TRY_TO_NUMBER(YEAR) AS BUDGET_YEAR,
    NULLIF(TRIM(BDGT_PRCD_NM),'') AS BUDGET_PROCEDURE,
    TO_VARCHAR(YEAR) AS YEAR_TXT, *
  FROM GN_DW.BRONZE_ERP.BDGT_ACMSLT_LEDGER
  WHERE INCOME_EXPS_DIV_NM <> 'TOTAL'
),
U AS (
  SELECT BUDGET_ITEM_DK,BUDGET_YEAR,BUDGET_PROCEDURE,1 MONTH_NO,YEAR_BDGT_AMT_1 YB,CHN_BDGT_AMT_1 CB,ADJ_BDGT_AMT_1 AB,EXEC_AMT_1 EX,YEAR_TXT FROM B
  UNION ALL SELECT BUDGET_ITEM_DK,BUDGET_YEAR,BUDGET_PROCEDURE,2,YEAR_BDGT_AMT_2,CHN_BDGT_AMT_2,ADJ_BDGT_AMT_2,EXEC_AMT_2,YEAR_TXT FROM B
  UNION ALL SELECT BUDGET_ITEM_DK,BUDGET_YEAR,BUDGET_PROCEDURE,3,YEAR_BDGT_AMT_3,CHN_BDGT_AMT_3,ADJ_BDGT_AMT_3,EXEC_AMT_3,YEAR_TXT FROM B
  UNION ALL SELECT BUDGET_ITEM_DK,BUDGET_YEAR,BUDGET_PROCEDURE,4,YEAR_BDGT_AMT_4,CHN_BDGT_AMT_4,ADJ_BDGT_AMT_4,EXEC_AMT_4,YEAR_TXT FROM B
  UNION ALL SELECT BUDGET_ITEM_DK,BUDGET_YEAR,BUDGET_PROCEDURE,5,YEAR_BDGT_AMT_5,CHN_BDGT_AMT_5,ADJ_BDGT_AMT_5,EXEC_AMT_5,YEAR_TXT FROM B
  UNION ALL SELECT BUDGET_ITEM_DK,BUDGET_YEAR,BUDGET_PROCEDURE,6,YEAR_BDGT_AMT_6,CHN_BDGT_AMT_6,ADJ_BDGT_AMT_6,EXEC_AMT_6,YEAR_TXT FROM B
