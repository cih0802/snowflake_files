select
    c.MEMBER_DK                                     as MEMBER_DK,          -- 자연키(= 팩트 조인키)
    -- ── 획득 귀속 축 ─────────────────────────────────────────────────────────
    c.ACQ_CAMPAIGN_SK                               as ACQ_CAMPAIGN_SK,
    c.ACQ_ORG_SK                                    as ACQ_ORG_SK,
    c.ACQ_SPONSORSHIP_SK                            as ACQ_SPONSORSHIP_SK,
