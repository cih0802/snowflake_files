describe table "GN_DW"."SILVER"."CRM_MEMBER_SPONSOR_SPAN"
[0m03:55:23.303879 [debug] [Thread-5 (]: SQL status: SUCCESS 1 in 0.560 seconds
[0m03:55:23.310881 [debug] [Thread-5 (]: Using snowflake connection "model.gn_dw_silver.CRM_SPONSOR_RELATION"
[0m03:55:23.311844 [debug] [Thread-5 (]: On model.gn_dw_silver.CRM_SPONSOR_RELATION: /* {"app": "dbt", "dbt_version": "1.9.4", "profile_name": "default", "target_name": "dev", "node_id": "model.gn_dw_silver.CRM_SPONSOR_RELATION"} */
create or replace  temporary view GN_DW.SILVER.CRM_SPONSOR_RELATION__dbt_tmp
  
   as (
    -- CRM_SPONSOR_RELATION: 결연(아동) 정제 + Q15 NO→ID 크로스워크 (BRONZE → SILVER), 정본 09 STEP3.
-- Co-authored with CoCo
-- 교차참조: SPNSR_BSNS_ID 는 CRM_MEMBER_SPONSOR_BIZ 에서 조인 채움(단방향 BRONZE→SILVER 예외 아님, SILVER dim 참조).
SELECT
  r.RELATNSP_KEY                     AS RELATNSP_KEY,
  NULLIF(TRIM(r.SPNSR_NO),'')        AS SPNSR_NO,
  r.SPNSR_BSNS_NO                    AS SPNSR_BSNS_NO,
  biz.SPNSR_BSNS_ID                  AS SPNSR_BSNS_ID,
  r.CHILD_CD                         AS CHILD_CD,
  NULLIF(TRIM(r.MBER_NO),'')         AS MBER_NO,
  r.RELATNSP_STRT_DE                 AS RELATNSP_STRT_DE,
  r.RELATNSP_DSCNTC_DE               AS RELATNSP_DSCNTC_DE,
  NULLIF(TRIM(r.RELATNSP_DSCNTC_YN),'') AS RELATNSP_DSCNTC_YN,
  -- [2026-08-03 G3] 정본 코드컬럼 raw 전파. 원천 타입 NUMBER → CRM_CODE.DTL_CD_ID(VARCHAR) 조인 가능하도록 TO_VARCHAR.
  --   ⚠️ MM002 30종 중 16종이 폐지코드 → 라벨 조인 시 USE_YN 무필터 필수.
  NULLIF(TRIM(TO_VARCHAR(r.RELATNSP_DSCNTC_RSN_CD)),'') AS RELATNSP_DSCNTC_RSN_CD,  -- MM002
  'CRM'                              AS DW_SOURCE_SYSTEM,
  CURRENT_TIMESTAMP()                AS DW_LOAD_TS,
  CURRENT_TIMESTAMP()                AS DW_UPDATE_TS,
  NULL                               AS DW_BATCH_ID
