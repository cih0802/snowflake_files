-- depends_on: GN_DW.GOLD.WIDE_AD_PERFORMANCE
-- depends_on: GN_DW.GOLD.WIDE_AD_BROADCAST
-- depends_on: GN_DW.GOLD.WIDE_AD_DIGITAL
-- depends_on: GN_DW.GOLD.WIDE_AD_BROADCAST_CASE
