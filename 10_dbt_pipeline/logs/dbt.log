create or replace  temporary view GN_DW.SILVER.CRM_SEND_MEMBER_OPEN_LOG__dbt_tmp
  
   as (
    -- CRM_SEND_MEMBER_OPEN_LOG: 메시지 발송 메일 오픈 로그 정제 (BRONZE SND_MEMBER_OPEN_LOG → SILVER)
-- Co-authored with CoCo
--
-- ============================================================================
-- [2026-09-16 O162 신설]
-- ----------------------------------------------------------------------------
-- 구 SND_MEMBER_LIST.OPEN_DT 가 확장된 오픈 세부 로그.
-- ============================================================================
SELECT
  LOG_SEQ                             AS LOG_SEQ,          -- PK. 로그순번
  REQ_SEQ_NO                          AS REQ_SEQ_NO,       -- 발송요청순번 (→CRM_SEND_REQUEST)
  R_NUM                               AS R_NUM,            -- 순번 (→CRM_SEND_MEMBER)
  NULLIF(TRIM(MBER_NO),'')            AS MBER_NO,          -- 회원번호
  OPEN_DT                             AS OPEN_DT,          -- 오픈일시
  FRST_REGIST_DT                      AS FRST_REGIST_DT,   -- 최초등록일시
  'CRM'                               AS DW_SOURCE_SYSTEM,
  CURRENT_TIMESTAMP()                 AS DW_LOAD_TS,
  CURRENT_TIMESTAMP()                 AS DW_UPDATE_TS,
  NULL                                AS DW_BATCH_ID
FROM GN_DW.BRONZE_CRM.SND_MEMBER_OPEN_LOG
WHERE LOG_SEQ IS NOT NULL
  );
[0m18:14:50.576931 [debug] [Thread-2 (]: SQL status: SUCCESS 1 in 0.748 seconds
[0m18:14:50.585579 [debug] [Thread-2 (]: Using snowflake connection "model.gn_dw_silver.CRM_SEND_REQUEST"
[0m18:14:50.588621 [debug] [Thread-2 (]: On model.gn_dw_silver.CRM_SEND_REQUEST: /* {"app": "dbt", "dbt_version": "1.9.4", "profile_name": "default", "target_name": "dev", "node_id": "model.gn_dw_silver.CRM_SEND_REQUEST"} */
create or replace  temporary view GN_DW.SILVER.CRM_SEND_REQUEST__dbt_tmp
  
   as (
    -- CRM_SEND_REQUEST: 발송요청 마스터 = EMAIL ∪ MSG_AT ∪ PSTMTR ∪ SND (채널별 dedup), 정본 09 STEP3.
-- Co-authored with CoCo
-- [2026-08-03 G3] 정본 코드컬럼 raw 전파 3종 신설. 채널별로 원천 컬럼 보유가 다르므로 미보유 채널은 NULL 이다.
--   MSG_DIV_CD(MS010)·SNDNG_TIME_DIV_CD(MS267) = MSG_AT 전용 · PSTMTR_PRCS_STAT_CD(MS061) = PSTMTR 전용.
--   ⚠️ 0 이나 '' 로 채우지 않는다 — 채널에 개념이 부재한 것이므로 NULL 이 정확하다(P21).
--   [O26] PSTMTR 접두 = 원천 테이블 TM_MS_PSTMTR_SNDNG 변별토큰. CRM_PAYMENT_BILLING.MBRFEE_PRCS_STAT_CD(PM013)와
--   동명이의였다 — 실측 도메인 0,1 vs R,F,S 로 완전 분리. 라벨은 수요 확인 후 별도 배선(스캐폴드 금지).
SELECT SNDNG_KEY AS SNDNG_KEY, 'EMAIL' AS SEND_CHANNEL, NULLIF(TRIM(SNDNG_TY_CD),'') AS SNDNG_TY_CD,
  NULL AS SEND_GBN_TOP, NULL AS SEND_GBN_TOP_NM, NULL AS SEND_GBN_MID, NULL AS SEND_GBN_MID_NM,
  NULL AS SEND_GBN_BOT, NULL AS SEND_GBN_BOT_NM,
  NULLIF(TRIM(TIT),'') AS TIT, SNDNG_STDR_DE::TIMESTAMP_NTZ AS SNDNG_STDR_DE, NULL AS REQ_SEQ_NO,
  CAST(NULL AS VARCHAR) AS MSG_DIV_CD, CAST(NULL AS VARCHAR) AS PSTMTR_PRCS_STAT_CD, CAST(NULL AS VARCHAR) AS SNDNG_TIME_DIV_CD,
  'CRM' AS DW_SOURCE_SYSTEM, 'BRONZE_CRM.TM_MS_EMAIL_SNDNG' AS DW_SOURCE_TABLE,
  CURRENT_TIMESTAMP() AS DW_LOAD_TS, CURRENT_TIMESTAMP() AS DW_UPDATE_TS, NULL AS DW_BATCH_ID
FROM GN_DW.BRONZE_CRM.TM_MS_EMAIL_SNDNG WHERE SNDNG_KEY IS NOT NULL
QUALIFY ROW_NUMBER() OVER (PARTITION BY SNDNG_KEY ORDER BY SNDNG_STDR_DE DESC NULLS LAST)=1
UNION ALL
SELECT SNDNG_KEY,'MSG_AT',NULLIF(TRIM(SNDNG_TY_CD),''), NULL,NULL,NULL,NULL,NULL,NULL,
