    'ee5e1fec-7267-40a8-b1e1-d4c9d56c2a9b'                    AS DW_BATCH_ID
from o

union all
-- unknown 멤버(SK=0): 팩트 ORG_SK=0(미매핑) 조인 유실 방지
select 0, 0, NULL, NULL, '(미매핑)', NULL, NULL, NULL, NULL,
