from GN_DW.GOLD.FACT_MEMBER_MONTHLY
where (HAS_BILLING = TRUE  and PAID_SPONSOR_BIZ_CNT is null)
   or (HAS_BILLING = FALSE and PAID_SPONSOR_BIZ_CNT is not null)
group by 1 having COUNT(*) > 0

