create or replace   view GN_DW.GOLD.WIDE_BUDGET
  
   as (
    -- WIDE_BUDGET: 예산 팩트(FBD) 평탄화 소비뷰 — ref() 거버넌스 (정본 09_빅테이블 VIEW.md §3.9)
-- Co-authored with CoCo
