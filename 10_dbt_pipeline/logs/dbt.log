  UNION ALL SELECT BUDGET_ITEM_DK,BUDGET_YEAR,BUDGET_PROCEDURE,DVLP_INBOUND_PATH,BDGT_UNIT_NM,8,YEAR_BDGT_AMT_8,CHN_BDGT_AMT_8,ADJ_BDGT_AMT_8,EXEC_AMT_8,YEAR_TXT FROM B
  UNION ALL SELECT BUDGET_ITEM_DK,BUDGET_YEAR,BUDGET_PROCEDURE,DVLP_INBOUND_PATH,BDGT_UNIT_NM,9,YEAR_BDGT_AMT_9,CHN_BDGT_AMT_9,ADJ_BDGT_AMT_9,EXEC_AMT_9,YEAR_TXT FROM B
  UNION ALL SELECT BUDGET_ITEM_DK,BUDGET_YEAR,BUDGET_PROCEDURE,DVLP_INBOUND_PATH,BDGT_UNIT_NM,10,YEAR_BDGT_AMT_10,CHN_BDGT_AMT_10,ADJ_BDGT_AMT_10,EXEC_AMT_10,YEAR_TXT FROM B
  UNION ALL SELECT BUDGET_ITEM_DK,BUDGET_YEAR,BUDGET_PROCEDURE,DVLP_INBOUND_PATH,BDGT_UNIT_NM,11,YEAR_BDGT_AMT_11,CHN_BDGT_AMT_11,ADJ_BDGT_AMT_11,EXEC_AMT_11,YEAR_TXT FROM B
  UNION ALL SELECT BUDGET_ITEM_DK,BUDGET_YEAR,BUDGET_PROCEDURE,DVLP_INBOUND_PATH,BDGT_UNIT_NM,12,YEAR_BDGT_AMT_12,CHN_BDGT_AMT_12,ADJ_BDGT_AMT_12,EXEC_AMT_12,YEAR_TXT FROM B
