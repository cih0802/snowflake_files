create or replace view GN_DW.GOLD.WIDE_MEMBER_FEE
    (
      MONTH_KEY COMMENT $$회비월 YYYYMM (무효/NULL 이면 납입월 폴백, 둘 다 무효면 0=Unknown월 — FMM 과 동일 규칙)$$,
