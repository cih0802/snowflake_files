[0m18:37:31.986937 [debug] [Thread-4 (]: On model.gn_dw_silver.DIM_MEMBER_IDENTITY: /* {"app": "dbt", "dbt_version": "1.9.4", "profile_name": "default", "target_name": "dev", "node_id": "model.gn_dw_silver.DIM_MEMBER_IDENTITY"} */
merge into GN_DW.GOLD.DIM_MEMBER_IDENTITY as DBT_INTERNAL_DEST
        using GN_DW.GOLD.DIM_MEMBER_IDENTITY__dbt_tmp as DBT_INTERNAL_SOURCE
        on ((DBT_INTERNAL_SOURCE.IDENTITY_SK = DBT_INTERNAL_DEST.IDENTITY_SK))

    
    when matched then update set
        "IDENTITY_SK" = DBT_INTERNAL_SOURCE."IDENTITY_SK","MEMBER_DK" = DBT_INTERNAL_SOURCE."MEMBER_DK","MEMBER_NO" = DBT_INTERNAL_SOURCE."MEMBER_NO","MEMNUM" = DBT_INTERNAL_SOURCE."MEMNUM","GA_MEMBER_ID" = DBT_INTERNAL_SOURCE."GA_MEMBER_ID","HOMEPAGE_ID" = DBT_INTERNAL_SOURCE."HOMEPAGE_ID","CHILD_CODE" = DBT_INTERNAL_SOURCE."CHILD_CODE","DW_SOURCE_SYSTEM" = DBT_INTERNAL_SOURCE."DW_SOURCE_SYSTEM","DW_LOAD_TS" = DBT_INTERNAL_SOURCE."DW_LOAD_TS","DW_UPDATE_TS" = DBT_INTERNAL_SOURCE."DW_UPDATE_TS","DW_BATCH_ID" = DBT_INTERNAL_SOURCE."DW_BATCH_ID"
    

    when not matched then insert
        ("IDENTITY_SK", "MEMBER_DK", "MEMBER_NO", "MEMNUM", "GA_MEMBER_ID", "HOMEPAGE_ID", "CHILD_CODE", "DW_SOURCE_SYSTEM", "DW_LOAD_TS", "DW_UPDATE_TS", "DW_BATCH_ID")
    values
        ("IDENTITY_SK", "MEMBER_DK", "MEMBER_NO", "MEMNUM", "GA_MEMBER_ID", "HOMEPAGE_ID", "CHILD_CODE", "DW_SOURCE_SYSTEM", "DW_LOAD_TS", "DW_UPDATE_TS", "DW_BATCH_ID")

;
