left join GN_DW.GOLD.FACT_AD_DIGITAL   dig on fap.AD_PERF_DK = dig.AD_PERF_DK
left join GN_DW.GOLD.FACT_AD_BROADCAST brc on fap.AD_PERF_DK = brc.AD_PERF_DK
    );
