--         경고는 게이트가 아니다(P105). O53 에서 실제로 이 경고로 잡았다.
-- depends_on: GN_DW.GOLD.WIDE_MEMBER_MONTHLY
-- depends_on: GN_DW.GOLD.WIDE_MEMBER_EVENT
-- depends_on: GN_DW.GOLD.WIDE_MEMBER_FEE
