    , EVENT_SEQ                 as EVENT_SEQ
    , count(*)                  as DUP_ROWS
    , min(EVENT_DT)             as FIRST_DT
    , max(EVENT_DT)             as LAST_DT
from GN_DW.SILVER.GA4_EVENT
group by all
having count(*) > 1
      
    ) dbt_internal_test
