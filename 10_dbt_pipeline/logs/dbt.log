    CHANNEL_COMPANY         as CHANNEL_COMPANY,         -- 채널사
    CHANNEL_COMPANY_TYPE    as CHANNEL_COMPANY_TYPE,    -- 채널사유형 (VIDEO 전용)
    SPOT_TYPE               as SPOT_TYPE,               -- SPOT유형 (VIDEO 전용)
    DURATION_SEC            as DURATION_SEC,            -- 광고 초수 (VIDEO 전용)
