    INICIS_ACNT_NO,
    USE_YN,
    REFER_URL,
    SPNSR_BSNS_ID,
    CMPGN_DC,
    EMRGNCY_AID_BPLC_CD,
    CMPGN_PRPT_YN,
    ATCHFL_ID,
    RM,
    MBER_INFLOW_PATH_CD,
    CMPGN_CTGR_CD,
    CMPGN_TYPE1_BSN,
    CMPGN_TYPE2_BSN,
    MKTG_CMPGN_NM,
