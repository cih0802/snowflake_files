    CAST(NULL AS FLOAT),                                    -- CONV_UNIT_CNT:   O16 — GA 개념 없음(개발실적은 FAD_B)
    TRY_TO_NUMBER(NULLIF(NULLIF(NULLIF(TRIM(INBOUND_CALL_CNT), ''), 'NULL'), '-')),     -- 실측 REBRDC=TEXT
    CAST(NULL AS FLOAT),                                    -- CONV_CALL_CNT: 영상 전용
