    CAST(NULL AS FLOAT),                                    -- CONV_MEMBER_CNT: GA 개념 없음
    CAST(NULL AS FLOAT),                                    -- CONV_UNIT_CNT:   GA 개념 없음
    INBOUND_CALL_CNT,
    CONV_CALL_CNT,
    AD_CNT,
    ACTL_PUR_AD_COST_KRW,
    '집행',
    'AGENCY',
    'BRONZE_AGENCY.VIDEO_AD_CMPGN_DTLS',
    CURRENT_TIMESTAMP()::TIMESTAMP_NTZ,
    CURRENT_TIMESTAMP()::TIMESTAMP_NTZ,
