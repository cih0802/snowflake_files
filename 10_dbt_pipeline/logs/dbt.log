    CAST(NULL AS VARCHAR)                          as TEAM,        -- ② 보류(E-6 입고 시 재개)
    ACMSLT_UPPER_DEPT_ID                          as ACMSLT_UPPER_DEPT_ID,  -- 원천 그대로
    ACMSLT_DEPT_YN                                as ACMSLT_DEPT_YN,        -- 원천 그대로
