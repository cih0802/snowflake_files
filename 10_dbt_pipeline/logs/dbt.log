    CURRENT_TIMESTAMP()::TIMESTAMP_NTZ       AS DW_UPDATE_TS,
    'abea3e7a-83f6-47a5-ac52-d86c5f93c194'                    AS DW_BATCH_ID
from GN_DW.SILVER.AGENCY_AD_DIGITAL
  );
