    b.IS_ACTIVE_USER                                             AS IS_ACTIVE_USER,
    b.BATCH_ORDERING_ID                                          AS BATCH_ORDERING_ID,
    NULL                                                          AS SRC_TABLE,
    NULL                                                          AS SRC_FILE_NAME,
