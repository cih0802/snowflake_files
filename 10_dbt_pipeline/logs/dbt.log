    CURRENT_TIMESTAMP()::TIMESTAMP_NTZ       AS DW_UPDATE_TS,
    'd38ba6a1-836d-4cd8-ac8f-ef838313ba18'                    AS DW_BATCH_ID,
    NULL, NULL, NULL
  );
