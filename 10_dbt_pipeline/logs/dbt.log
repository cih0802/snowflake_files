  CAST('CRM' AS VARCHAR)       AS DW_SOURCE_SYSTEM,
  CAST(NULL AS VARCHAR)        AS DW_SOURCE_TABLE,
  CURRENT_TIMESTAMP()          AS DW_LOAD_TS,
  CAST(NULL AS TIMESTAMP_NTZ)  AS DW_UPDATE_TS,
  CAST(NULL AS VARCHAR)        AS DW_BATCH_ID
WHERE 1=0
  );
