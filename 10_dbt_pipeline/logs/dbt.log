left join GN_DW.GOLD.DIM_ORG          org on org.ORG_SK          = c.ACQ_ORG_SK
left join GN_DW.GOLD.DIM_SPONSORSHIP  spb on spb.SPONSORSHIP_SK  = c.ACQ_SPONSORSHIP_SK
