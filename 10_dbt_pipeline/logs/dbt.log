    LAST_STOP_DATE,
    EFFECTIVE_FROM,
    DW_SOURCE_SYSTEM,
    DW_LOAD_TS,
    DW_UPDATE_TS,
    DW_BATCH_ID
from GN_DW.GOLD.DIM_MEMBER
where IS_CURRENT
  );
