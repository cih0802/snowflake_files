  NULLIF(TRIM(LINK_ID),'')            AS LINK_ID,          -- 링크ID
  NULLIF(TRIM(LINK_NM),'')            AS LINK_NM,          -- 링크명
  NULLIF(TRIM(LINK_PAGE),'')          AS LINK_PAGE,        -- 링크페이지
  NULLIF(TRIM(LINK_IMG_URL),'')       AS LINK_IMG_URL,     -- 링크이미지URL
