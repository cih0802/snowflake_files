    values
        ("IDENTITY_SK", "MEMBER_DK", "MEMBER_NO", "MEMNUM", "GA_MEMBER_ID", "HOMEPAGE_ID", "CHILD_CODE", "DW_SOURCE_SYSTEM", "DW_LOAD_TS", "DW_UPDATE_TS", "DW_BATCH_ID")

