    c.BRAND      as CAMPAIGN_BRAND,
    c.CAMPAIGN_NAME
from GN_DW.GOLD.FACT_TARGET_BIZ f
left join GN_DW.GOLD.DIM_ORG         o on f.ORG_SK = o.ORG_SK
left join GN_DW.GOLD.DIM_SPONSORSHIP s on f.SPONSORSHIP_SK = s.SPONSORSHIP_SK
