        ("BUDGET_ITEM_SK", "BUDGET_ITEM_NAME", "BUDGET_CATEGORY", "DW_SOURCE_SYSTEM", "DW_LOAD_TS", "DW_UPDATE_TS", "DW_BATCH_ID")
    values
