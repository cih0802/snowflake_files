    APPLCNT_ETC_CTTPC_REL_CD,
    APPLCNT_MBER_REL_CD,
    BF_SETLE_KEY,
    OPERT_DIV_CD,
    CRTFC_TY_CD,
    USE_YN,
    REGIST_DT,
    'CRM'                       AS DW_SOURCE_SYSTEM,
    CURRENT_TIMESTAMP()::TIMESTAMP_NTZ       AS DW_LOAD_TS,
    CURRENT_TIMESTAMP()::TIMESTAMP_NTZ       AS DW_UPDATE_TS,
    '0a36d1dd-dc29-4309-90bf-a4409d1ae271'                    AS DW_BATCH_ID
from GN_DW.SILVER.CRM_PAYMENT_METHOD_HIST
  );
