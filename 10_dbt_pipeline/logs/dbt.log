    NULLIF(NULLIF(NULLIF(TRIM(UPPER_CMPGN_NM), ''), 'NULL'), '-'),
    NULLIF(NULLIF(NULLIF(TRIM(CHNNL_NM), ''), 'NULL'), '-'),
