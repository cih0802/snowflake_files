create or replace   view GN_DW.GOLD.WIDE_AD_DIGITAL
  
   as (
    -- WIDE_AD_DIGITAL: 디지털광고 위성 팩트(FAD_D) 평탄화 소비뷰 — 순서9-I 신설(DEC-8)
