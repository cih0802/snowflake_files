          "platform"                          AS platform,
          "is_active_user"                    AS is_active_user,
          "batch_ordering_id"                 AS batch_ordering_id
        FROM GN_DW.BRONZE_GA4."events_20260719"
        
      
    
  
 ) e, LATERAL FLATTEN(input => e.event_params) p
