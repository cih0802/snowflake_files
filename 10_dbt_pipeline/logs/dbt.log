[0m21:02:46.732607 [debug] [Thread-4 (]: On model.gn_dw_silver.DIM_AD_CREATIVE: /* {"app": "dbt", "dbt_version": "1.9.4", "profile_name": "default", "target_name": "dev", "node_id": "model.gn_dw_silver.DIM_AD_CREATIVE"} */
merge into GN_DW.GOLD.DIM_AD_CREATIVE as DBT_INTERNAL_DEST
        using GN_DW.GOLD.DIM_AD_CREATIVE__dbt_tmp as DBT_INTERNAL_SOURCE
