LEFT JOIN GN_DW.SILVER.CRM_MEMBER_SPONSOR_BIZ biz
  ON biz.SPNSR_NO = NULLIF(TRIM(r.SPNSR_NO),'') AND biz.SPNSR_BSNS_NO = r.SPNSR_BSNS_NO
WHERE r.RELATNSP_KEY IS NOT NULL
  );
