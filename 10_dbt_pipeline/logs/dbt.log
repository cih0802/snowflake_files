        MAX(SOURCE_MEDIUM)  as SOURCE_MEDIUM
    from GN_DW.SILVER.GA4_TRAFFIC_SOURCE
    group by UTM_SOURCE, UTM_MEDIUM
)

select
    ABS(HASH(COALESCE(CAST(UTM_SOURCE AS VARCHAR), '∅') || '‖' || COALESCE(CAST(UTM_MEDIUM AS VARCHAR), '∅'))) as GA_SOURCE_SK,
