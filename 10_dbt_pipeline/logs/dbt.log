    CAST(NULL AS VARCHAR),                                  -- UPPER_CAMPAIGN_NM: 원천 부재
    NULLIF(NULLIF(NULLIF(TRIM(CHNNL_CMPNY), ''), 'NULL'), '-'),                         -- MEDIA_CHANNEL_NM
