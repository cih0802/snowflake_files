  'SILVER.BIGQUERY_REFINED_DATA' AS DW_SOURCE_TABLE,
  CURRENT_TIMESTAMP()            AS DW_LOAD_TS,
  CURRENT_TIMESTAMP()            AS DW_UPDATE_TS,
  NULL                           AS DW_BATCH_ID
FROM GN_DW.SILVER.BIGQUERY_REFINED_DATA
  );
