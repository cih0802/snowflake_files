create or replace   view GN_DW.GOLD.WIDE_TARGET_BIZ
  
   as (
    -- WIDE_TARGET_BIZ: 사업목표 팩트(FTG_B) 평탄화 소비뷰 — ref() 거버넌스 (정본 09_빅테이블 VIEW.md §3.4)
