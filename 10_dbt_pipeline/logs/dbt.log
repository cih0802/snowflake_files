    CURRENT_TIMESTAMP()::TIMESTAMP_NTZ       AS DW_UPDATE_TS,
    '57be0253-4fb4-4b86-9e2e-7ed1d1292984'                    AS DW_BATCH_ID
from GN_DW.SILVER.AGENCY_AD_BROADCAST
  );
