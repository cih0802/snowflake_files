    DAY_DIV                 as DAY_DIV,                 -- 요일구분 평일/주말 (VIDEO 전용)
    PRG_START_TIME          as PRG_START_TIME,          -- 프로그램 시작시간 (VIDEO 전용)
    CTV_DIV                 as CTV_DIV,                 -- CTV구분 (VIDEO 전용)
