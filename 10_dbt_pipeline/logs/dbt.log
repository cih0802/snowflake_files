  TRY_TO_NUMBER(YEAR)              AS BUDGET_YEAR,
  NULLIF(TRIM(INCOME_EXPS_DIV_NM),'') AS INCOME_EXPENSE_DIV,
  NULLIF(TRIM(BDGT_UNIT_NM),'')    AS BUDGET_UNIT_NM,
  NULLIF(TRIM(JANG_NM),'')         AS JANG_NM,
