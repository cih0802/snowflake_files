    AD_VIEW_RT_SRC          as AD_VIEW_RT_SRC,          -- N(비가산) 대행사 산정, 재계산 불가
    CPC_SRC                 as CPC_SRC,                 -- N(비가산) 대행사 산정, DW=AD_COST/CLICKS
    'AGENCY'                       AS DW_SOURCE_SYSTEM,
