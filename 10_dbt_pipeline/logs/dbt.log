-- 🔴 DEC-44 집행 검증: 최신 차수만 필터링한 FACT_BUDGET 은 (MONTH_KEY, BUDGET_ITEM_SK) 가 유일해야 한다.
-- 판정: 반환 행이 있으면 ERROR.


SELECT
    MONTH_KEY,
    BUDGET_ITEM_SK,
    COUNT(*) AS N_ROWS
FROM GN_DW.GOLD.FACT_BUDGET
