           NULLIF(NULLIF(NULLIF(TRIM(CASE3_FAM_TY_NM), ''), 'NULL'), '-'),
           NULLIF(NULLIF(NULLIF(TRIM(CASE3_APPEAL_POINT_NM), ''), 'NULL'), '-'),
           NULLIF(NULLIF(NULLIF(TRIM(CASE3_CASE_DIV_NM), ''), 'NULL'), '-')
    FROM GN_DW.SILVER.AGENCY_AD_ROW_REBRDC
