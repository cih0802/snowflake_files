         THEN TRY_TO_NUMBER(TO_CHAR(TRY_TO_DATE(SPNSR_DSCNTC_DE,'YYYYMMDD'), 'YYYYMMDD')) END, 0) as DATE_SK,   -- 범위밖/NULL → 0 (순서9)
        MBER_NO                                             as MEMBER_DK,
        'STOP'                                              as EVENT_TYPE,
