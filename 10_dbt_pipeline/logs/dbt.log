    f.CMMN_BRND_NM_AT_EVENT         as CAMPAIGN_CMMN_BRND,           -- MM297 공통브랜드 라벨
    f.MKTG_UTM_NM_AT_EVENT          as CAMPAIGN_MKTG_UTM,            -- TM_CM_MKTNG_UTM 라벨
