    ROW_HASH                AS ROW_HASH,
    DUP_SEQ                 AS DUP_SEQ,
    TIME, YEAR, CPR_NM, DMST_OVSEA_DIV_NM, BSNS_CASE_DIV_NM, CMPGN_TY_NM, AD_TY_NM,
