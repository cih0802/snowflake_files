    AD_SOURCE_TYPE                                 AS AD_SOURCE_TYPE,
    'DIGITAL'                               AS SOURCE_SYSTEM,
    DATE                                    AS AD_DATE,
    YEAR(DATE)                              AS AD_YEAR,
