  'CRM'                        AS DW_SOURCE_SYSTEM,
  CURRENT_TIMESTAMP()          AS DW_LOAD_TS,
  CURRENT_TIMESTAMP()          AS DW_UPDATE_TS,
  NULL                         AS DW_BATCH_ID
FROM GN_DW.BRONZE_CRM.TC_CMMN_DTL_CD
WHERE CD_ID IS NOT NULL AND DTL_CD_ID IS NOT NULL
  );
