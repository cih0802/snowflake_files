    OBSERVABLE_12M_MEMBERS,
    -- [2026-08-06 O45] 물리 위치 = 맨 끝(ALTER ADD COLUMN 규약).
    ACQ_ORG_SK, ACQ_SPONSORSHIP_SK,
    -- [DEC-43] 캠페인 12속성 동결값 — 물리 위치 = 맨 끝(ALTER ADD COLUMN 규약).
    ACQ_MBER_INFLOW_PATH_CD, ACQ_MBER_INFLOW_PATH_NM,
