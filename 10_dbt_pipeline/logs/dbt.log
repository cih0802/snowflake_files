        MD5(TO_JSON(OBJECT_CONSTRUCT(*)))   AS ROW_HASH
    FROM GN_DW.BRONZE_AGENCY.REBRDC_AD_CMPGN_DTLS
),
seq AS (
    SELECT
        src.*,
