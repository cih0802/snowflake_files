with rel as (
    select RELATNSP_KEY, MBER_NO
    from GN_DW.SILVER.CRM_SPONSOR_RELATION
    qualify row_number() over (partition by RELATNSP_KEY order by MBER_NO) = 1
)
select
    COALESCE(CASE WHEN c.CHG_DE BETWEEN '1945-01-01' AND '2145-12-31'
         THEN TRY_TO_NUMBER(TO_CHAR(c.CHG_DE, 'YYYYMMDD')) END, 0)       as DATE_SK,
    r.MBER_NO                                  as MEMBER_DK,
    c.RELATNSP_KEY, c.CHG_RELATNSP_KEY,
