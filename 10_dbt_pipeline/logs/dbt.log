    NULLIF(NULLIF(NULLIF(TRIM(BRDC_NM), ''), 'NULL'), '-'),                                             -- PROGRAM_NM
    NULLIF(NULLIF(NULLIF(TRIM(CHNNL_CMPNY), ''), 'NULL'), '-'),                                         -- CHANNEL_COMPANY
