[0m17:26:43.894846 [debug] [Thread-2 (]: On model.gn_dw_silver.DIM_MEMBER_IDENTITY: /* {"app": "dbt", "dbt_version": "1.9.4", "profile_name": "default", "target_name": "dev", "node_id": "model.gn_dw_silver.DIM_MEMBER_IDENTITY"} */
create or replace  temporary view GN_DW.GOLD.DIM_MEMBER_IDENTITY__dbt_tmp
  
   as (
    -- DIM_MEMBER_IDENTITY: 회원 신원 브리지 (CRM_MEMBER × BIGQUERY_IDENTITY 매칭, IDENTITY_MEMBER_XREF 경유)
-- Co-authored with CoCo
-- ⚠️ 활성화(2026-07-15): SILVER BIGQUERY_IDENTITY 적재 확인 → enabled 해제. BIGQUERY_MEMBER_ID=exact member_id 매칭분만.
--    grain 보호: XREF는 user_pseudo_id 단위(1회원 최대 3 pseudo) → MEMBER_DK로 집계 후 조인(IDENTITY_SK 유일성 보장).
--    데이터 범위: 현재 BigQuery 샤드 기반(채움률 ~4.2%)·Q1 현업검증 대기. 행수는 BigQuery 입고 범위에 비례(전기간 입고 시 truncate+append로 자동 갱신).


with m as (
    select * from GN_DW.SILVER.CRM_MEMBER
),
-- XREF는 user_pseudo_id 단위 → MEMBER_DK로 집계(1회원 1행)해 fan-out(IDENTITY_SK 중복) 방지
xref as (
    select MEMBER_DK as X_MEMBER_DK, MAX(BIGQUERY_MEMBER_ID) as BIGQUERY_MEMBER_ID
    from GN_DW.SILVER.IDENTITY_MEMBER_XREF
    where MEMBER_DK is not null
    group by MEMBER_DK
)

select
    ABS(HASH(COALESCE(CAST(MEMBER_DK AS VARCHAR), '∅')))                  as IDENTITY_SK,
    MEMBER_DK                                     as MEMBER_DK,
    MEMBER_DK                                     as MEMBER_NO,
    CAST(NULL AS VARCHAR)                          as MEMNUM,         -- 🔴 전건 NULL. 정본 #111. 원천 실재 = SILVER.BIGQUERY_EVENT.PAGE_LOCATION 의 memnum= (17,795행·1,589종) — 미배선(phase-2). ⚠️ 단 GOLD.FACT_BIGQUERY_BEHAVIOR.PAGE_LOCATION 은 MAX() 대표값이라 680종만 남으므로 배선 원천은 SILVER 여야 한다
    x.BIGQUERY_MEMBER_ID                          as BIGQUERY_MEMBER_ID, -- exact member_id 매칭분(미매칭=NULL)
    HMPG_ID                                       as HOMEPAGE_ID,
