create or replace view GN_DW.GOLD.WIDE_AD_PERFORMANCE
    (
      AD_PERF_DK COMMENT $$광고성과 행 식별자(grain) — 위성 뷰 조인키$$,
      PERF_DATE_SK COMMENT $$광고 실적일 YYYYMMDD$$,
