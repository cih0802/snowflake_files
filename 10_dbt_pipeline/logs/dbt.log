left join GN_DW.GOLD.DIM_CAMPAIGN  c  on f.CAMPAIGN_SK  = c.CAMPAIGN_SK
left join GN_DW.GOLD.DIM_MEMBER_IDENTITY mi on f.IDENTITY_SK = mi.IDENTITY_SK
    );
