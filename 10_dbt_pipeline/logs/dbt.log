  and IS_MULTI_PAID_BIZ <> (PAID_SPONSOR_BIZ_CNT > 1)
group by 1 having COUNT(*) > 0

union all

select 'negative_cum', COUNT(*)
from GN_DW.GOLD.FACT_MEMBER_MONTHLY
