T $${{ c.description | replace(\'$\', \'[$]\') }}$${% endif %}\n      {{- "," if not loop.last -}}\n    {% endfor %}\n    )\n  {%- endif -%}\n{% endmacro %}', 'depends_on': {'macros': []}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [], 'created_at': 1792592620.843448, 'supported_languages': None}, 'macro.gn_dw_silver.materialization_gn_view_commented_snowflake': {'name': 'materialization_gn_view_commented_snowflake', 'resource_type': 'macro', 'package_name': 'gn_dw_silver', 'path': 'macros/gn_view_commented.sql', 'original_file_path': 'macros/gn_view_commented.sql', 'unique_id': 'macro.gn_dw_silver.materialization_gn_view_commented_snowflake', 'macro_sql': "{% materialization gn_view_commented, adapter='snowflake' %}\n\n  {%- set target_relation = this.incorporate(type='view') -%}\n\n  {{ run_hooks(pre_hooks) }}\n\n  {%- set col_list = gn_view_column_list() -%}\n  {%- set view_comment = model.get('description', none) -%}\n\n  {% call statement('main') -%}\n    create or replace view {{ target_relation }}\n    {{ col_list }}\n    {%- if view_comment %}\n    comment = $${{ view_comment | replace('$', '[$]') }}$$\n    {%- endif %}\n    as (\n      {{ sql }}\n    );\n  {%- endcall %}\n\n  {{ run_hooks(post_hooks) }}\n\n  {{ adapter.commit() }}\n\n  {{ return({'relations': [target_relation]}) }}\n\n{% endmaterialization %}", 'depends_on': {'macros': ['macro.dbt.run_hooks', 'macro.gn_dw_silver.gn_view_column_list', 'macro.dbt.statement']}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [], 'created_at': 1792592620.844452, 'supported_languages': ['sql']}, 'macro.gn_dw_silver.gold_fact_purge': {'name': 'gold_fact_purge', 'resource_type': 'macro', 'package_name': 'gn_dw_silver', 'path': 'macros/gold_fact_purge.sql', 'original_file_path': 'macros/gold_fact_purge.sql', 'unique_id': 'macro.gn_dw_silver.gold_fact_purge', 'macro_sql': "{% macro gold_fact_purge(relation) %}\n  {%- set RANGED_FACTS = ['FACT_BIGQUERY_BEHAVIOR', 'FACT_BIGQUERY_SESSION'] -%}  {#- O213-F FACT_BIGQUERY_SESSION(grain 첫 키 DATE_SK · 세션 일자 분할) -#}\n  {%- if relation.identifier | upper in RANGED_FACTS -%}\n    {%- if is_incremental() -%}\n      DELETE FROM {{ relation }}\n       WHERE {{ bigquery_range_predicate_sk('DATE_SK') }}\n    {%- else -%}\n      SELECT 1 /* gold_fact_purge no-op: 대상 테이블 미존재(최초 run) — DELETE 는 IF EXISTS 를 못 쓴다 */\n    {%- endif -%}\n  {%- else -%}\n    TRUNCATE TABLE IF EXISTS {{ relation }}\n  {%- endif -%}\n{% endmacro %}", 'depends_on': {'macros': ['macro.dbt.is_incremental', 'macro.gn_dw_silver.bigquery_range_predicate_sk']}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [], 'created_at': 1792592620.8454053, 'supported_languages': None}, 'macro.gn_dw_silver.gold_sk': {'name': 'gold_sk', 'resource_type': 'macro', 'package_name': 'gn_dw_silver', 'path': 'macros/gold_helpers.sql', 'original_file_path': 'macros/gold_helpers.sql', 'unique_id': 'macro.gn_dw_silver.gold_sk', 'macro_sql': "{% macro gold_sk(cols) -%}\n    ABS(HASH(\n        {%- for c in cols -%}\n            COALESCE(CAST({{ c }} AS VARCHAR), '∅')\n            {%- if not loop.last %} || '‖' || {% endif -%}\n        {%- endfor -%}\n    ))\n{%- endmacro %}", 'depends_on': {'macros': []}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [], 'created_at': 1792592620.8462234, 'supported_languages': None}, 'macro.gn_dw_silver.gold_meta': {'name': 'gold_meta', 'resource_type': 'macro', 'package_name': 'gn_dw_silver', 'path': 'macros/gold_helpers.sql', 'original_file_path': 'macros/gold_helpers.sql', 'unique_id': 'macro.gn_dw_silver.gold_meta', 'macro_sql': "{% macro gold_meta(src_system='CRM') -%}\n    '{{ src_system }}'                       AS DW_SOURCE_SYSTEM,\n    CURRENT_TIMESTAMP()::TIMESTAMP_NTZ       AS DW_LOAD_TS,\n    CURRENT_TIMESTAMP()::TIMESTAMP_NTZ       AS DW_UPDATE_TS,\n    '{{ invocation_id }}'                    AS DW_BATCH_ID\n{%- endmacro %}", 'depends_on': {'macros': []}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [], 'created_at': 1792592620.846449, 'supported_languages': None}, 'macro.gn_dw_silver.date_sk': {'name': 'date_sk', 'resource_type': 'macro', 'package_name': 'gn_dw_silver', 'path': 'macros/gold_helpers.sql', 'original_file_path': 'macros/gold_helpers.sql', 'unique_id': 'macro.gn_dw_silver.date_sk', 'macro_sql': '{% macro date_sk(date_col) -%}\n    CASE WHEN {{ date_col }} BETWEEN \'{{ var("cal_start") }}\' AND \'{{ var("cal_end") }}\'\n         THEN TRY_TO_NUMBER(TO_CHAR({{ date_col }}, \'YYYYMMDD\')) END\n{%- endmacro %}', 'depends_on': {'macros': []}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [], 'created_at': 1792592620.8467503, 'supported_languages': None}, 'macro.gn_dw_silver.month_key': {'name': 'month_key', 'resource_type': 'macro', 'package_name': 'gn_dw_silver', 'path': 'macros/gold_helpers.sql', 'original_file_path': 'macros/gold_helpers.sql', 'unique_id': 'macro.gn_dw_silver.month_key', 'macro_sql': "{% macro month_key(date_col) -%}\n    TRY_TO_NUMBER(TO_CHAR({{ date_col }}, 'YYYYMM'))\n{%- endmacro %}", 'depends_on': {'macros': []}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [], 'created_at': 1792592620.8469021, 'supported_languages': None}, 'macro.gn_dw_silver.month_key_clamp': {'name': 'month_key_clamp', 'resource_type': 'macro', 'package_name': 'gn_dw_silver', 'path': 'macros/gold_helpers.sql', 'original_file_path': 'macros/gold_helpers.sql', 'unique_id': 'macro.gn_dw_silver.month_key_clamp', 'macro_sql': '{% macro month_key_clamp(mk_num) -%}\n    {%- set lo = var("cal_start")[:7] | replace("-", "") -%}\n    {%- set hi = var("cal_end")[:7] | replace("-", "") -%}\n    CASE WHEN {{ mk_num }} BETWEEN {{ lo }} AND {{ hi }}\n          AND MOD({{ mk_num }}, 100) BETWEEN 1 AND 12\n         THEN {{ mk_num }} END\n{%- endmacro %}', 'depends_on': {'macros': []}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [], 'created_at': 1792592620.8474927, 'supported_languages': None}, 'macro.gn_dw_silver.month_key_offset': {'name': 'month_key_offset', 'resource_type': 'macro', 'package_name': 'gn_dw_silver', 'path': 'macros/gold_helpers.sql', 'original_file_path': 'macros/gold_helpers.sql', 'unique_id': 'macro.gn_dw_silver.month_key_offset', 'macro_sql': "{% macro month_key_offset(mk_num, n) -%}\n    CASE WHEN MOD({{ mk_num }}, 100) BETWEEN 1 AND 12 AND {{ mk_num }} >= 100001\n         THEN TRY_TO_NUMBER(TO_CHAR(\n                  ADD_MONTHS(TRY_TO_DATE(TO_VARCHAR({{ mk_num }}) || '01', 'YYYYMMDD'), {{ n }}),\n                  'YYYYMM'))\n    END\n{%- endmacro %}", 'depends_on': {'macros': []}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [], 'created_at': 1792592620.8477576, 'supported_languages': None}, 'macro.gn_dw_silver.clean_str': {'name': 'clean_str', 'resource_type': 'macro', 'package_name': 'gn_dw_silver', 'path': 'macros/silver_helpers.sql', 'original_file_path': 'macros/silver_helpers.sql', 'unique_id': 'macro.gn_dw_silver.clean_str', 'macro_sql': "{% macro clean_str(col) -%}\n    NULLIF(NULLIF(NULLIF(TRIM({{ col }}), ''), 'NULL'), '-')\n{%- endmacro %}", 'depends_on': {'macros': []}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [], 'created_at': 1792592620.8480716, 'supported_languages': None}, 'macro.gn_dw_silver.dw_meta': {'name': 'dw_meta', 'resource_type': 'macro', 'package_name': 'gn_dw_silver', 'path': 'macros/silver_helpers.sql', 'original_file_path': 'macros/silver_helpers.sql', 'unique_id': 'macro.gn_dw_silver.dw_meta', 'macro_sql': "{% macro dw_meta(src_table) -%}\n    'CRM'                                    AS DW_SOURCE_SYSTEM,\n    '{{ src_table }}'                        AS DW_SOURCE_TABLE,\n    CURRENT_TIMESTAMP()::TIMESTAMP_NTZ       AS DW_LOAD_TS,\n    CURRENT_TIMESTAMP()::TIMESTAMP_NTZ       AS DW_UPDATE_TS,\n    '{{ invocation_id }}'                    AS DW_BATCH_ID\n{%- endmacro %}", 'depends_on': {'macros': []}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [], 'created_at': 1792592620.8482785, 'supported_languages': None}, 'macro.gn_dw_silver.silver_purge': {'name': 'silver_purge', 'resource_type': 'macro', 'package_name': 'gn_dw_silver', 'path': 'macros/silver_purge.sql', 'original_file_path': 'macros/silver_purge.sql', 'unique_id': 'macro.gn_dw_silver.silver_purge', 'macro_sql': "{% macro silver_purge(relation) %}\n  {%- set RANGED_MODELS = ['BIGQUERY_EVENT', 'BIGQUERY_BASIC', 'BIGQUERY_SESSION'] -%}  {#- O213-F BIGQUERY_SESSION(EVENT_DT 보유 · 일자 내 폐쇄) -#}\n  {%- if relation.identifier | upper in RANGED_MODELS -%}\n    {{ bigquery_range_purge(relation) }}\n  {%- else -%}\n    TRUNCATE TABLE IF EXISTS {{ relation }}\n  {%- endif -%}\n{% endmacro %}", 'depends_on': {'macros': ['macro.gn_dw_silver.bigquery_range_purge']}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [], 'created_at': 1792592620.8489904, 'supported_languages': None}, 'macro.dbt_snowflake.get_column_comment_sql': {'name': 'get_column_comment_sql', 'resource_type': 'macro', 'package_name': 'dbt_snowflake', 'path': 'macros/adapters.sql', 'original_file_path': 'macros/adapters.sql', 'unique_id': 'macro.dbt_snowflake.get_column_comment_sql', 'macro_sql': "{% macro get_column_comment_sql(column_name, column_dict) -%}\n  {% if (column_name|upper in column_dict) -%}\n    {% set matched_column = column_name|upper -%}\n  {% elif (column_name|lower in column_dict) -%}\n    {% set matched_column = column_name|lower -%}\n  {% elif (column_name in column_dict) -%}\n    {% set matched_column = column_name -%}\n  {% else -%}\n    {% set matched_column = None -%}\n  {% endif -%}\n  {% if matched_column -%}\n    {{ adapter.quote(column_name) }} COMMENT $${{ column_dict[matched_column]['description'] | replace('$', '[$]') }}$$\n  {%- else -%}\n    {{ adapter.quote(column_name) }} COMMENT $$$$\n  {%- endif -%}\n{% endmacro %}", 'depends_on': {'macros': []}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [], 'created_at': 1792592620.8521872, 'supported_languages': None}, 'macro.dbt_snowflake.get_persist_docs_column_list': {'name': 'get_persist_docs_column_list', 'resource_type': 'macro', 'package_name': 'dbt_snowflake', 'path': 'macros/adapters.sql', 'original_file_path': 'macros/adapters.sql', 'unique_id': 'macro.dbt_snowflake.get_persist_docs_column_list', 'macro_sql': '{% macro get_persist_docs_column_list(model_columns, query_columns) %}\n(\n  {% for column_name in query_columns %}\n    {{ get_column_comment_sql(column_name, model_columns) }}\n    {{- ", " if not loop.last else "" }}\n  {% endfor %}\n)\n{% endmacro %}', 'depends_on': {'macros': ['macro.dbt_snowflake.get_column_comment_sql']}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [], 'created_at': 1792592620.852588, 'supported_languages': None}, 'macro.dbt_snowflake.snowflake__get_columns_in_relation': {'name': 'snowflake__get_columns_in_relation', 'resource_type': 'macro', 'package_name': 'dbt_snowflake', 'path': 'macros/adapters.sql', 'original_file_path': 'macros/adapters.sql', 'unique_id': 'macro.dbt_snowflake.snowflake__get_columns_in_relation', 'macro_sql': "{% macro snowflake__get_columns_in_relation(relation) -%}\n  {%- set sql -%}\n    describe table {{ relation.render() }}\n  {%- endset -%}\n  {%- set result = run_query(sql) -%}\n\n  {% set maximum = 10000 %}\n  {% if (result | length) >= maximum %}\n    {% set msg %}\n      Too many columns in relation {{ relation.render() }}! dbt can only get\n      information about relations with fewer than {{ maximum }} columns.\n    {% endset %}\n    {% do exceptions.raise_compiler_error(msg) %}\n  {% endif %}\n\n  {% set columns = [] %}\n  {% for row in result %}\n    {% do columns.append(api.Column.from_description(row['name'], row['type'])) %}\n  {% endfor %}\n  {% do return(columns) %}\n{% endmacro %}", 'depends_on': {'macros': ['macro.dbt.run_query']}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [], 'created_at': 1792592620.8537219, 'supported_languages': None}, 'macro.dbt_snowflake.snowflake__show_object_metadata': {'name': 'snowflake__show_object_metadata', 'resource_type': 'macro', 'package_name': 'dbt_snowflake', 'path': 'macros/adapters.sql', 'original_file_path': 'macros/adapters.sql', 'unique_id': 'macro.dbt_snowflake.snowflake__show_object_