--   이 1행이 GOLD 전체에 남아 있던 마지막 '미상' 이다(문서10 §14-D 실측) → 이로써 GOLD '미상' 은 소멸.
select 0, '(미매핑)', NULL, '(미매핑)', NULL, '(미매핑)', NULL, NULL, NULL, NULL,
