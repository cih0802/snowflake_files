        --   FME 에 실배선됐다(종전 전건 0 은 O8 문제가 아니라 **배선 누락**이었다).
        ORG_SK, SPONSORSHIP_SK,
        AGE_AT_EVENT, AGE_BAND_AT_EVENT, AREA_CD_AT_EVENT, REGION_AT_EVENT,
        SEX_AT_EVENT, GENDER_AT_EVENT, SPNSR_AMT,
