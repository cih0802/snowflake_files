    when matched then update set
        "AD_CREATIVE_SK" = DBT_INTERNAL_SOURCE."AD_CREATIVE_SK","AD_CREATIVE_BK" = DBT_INTERNAL_SOURCE."AD_CREATIVE_BK","MEDIA_NAME" = DBT_INTERNAL_SOURCE."MEDIA_NAME","PLATFORM" = DBT_INTERNAL_SOURCE."PLATFORM","PLATFORM_TYPE" = DBT_INTERNAL_SOURCE."PLATFORM_TYPE","CREATIVE" = DBT_INTERNAL_SOURCE."CREATIVE","CM_POSITION" = DBT_INTERNAL_SOURCE."CM_POSITION","DURATION_SEC" = DBT_INTERNAL_SOURCE."DURATION_SEC","RT_TYPE" = DBT_INTERNAL_SOURCE."RT_TYPE","AD_TYPE" = DBT_INTERNAL_SOURCE."AD_TYPE","TARGET_GROUP" = DBT_INTERNAL_SOURCE."TARGET_GROUP","DW_SOURCE_SYSTEM" = DBT_INTERNAL_SOURCE."DW_SOURCE_SYSTEM","DW_LOAD_TS" = DBT_INTERNAL_SOURCE."DW_LOAD_TS","DW_UPDATE_TS" = DBT_INTERNAL_SOURCE."DW_UPDATE_TS","DW_BATCH_ID" = DBT_INTERNAL_SOURCE."DW_BATCH_ID"
    

    when not matched then insert
