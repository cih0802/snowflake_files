--       event_name(+안정 category/action)으로 conform 하고 label 은 팩트측에 유지할 것.

SELECT DISTINCT
  EVENT_NAME                     AS EVENT_NAME,
  EVENT_CATEGORY                 AS EVENT_CATEGORY,
  EVENT_LABEL                    AS EVENT_LABEL,
  EVENT_ACTION                   AS EVENT_ACTION,
