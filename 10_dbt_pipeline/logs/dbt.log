where v.VIEW_COMMENT is null
   or TRIM(v.VIEW_COMMENT) = ''
   or COALESCE(c.COLS_NO_COMMENT, 0) > 0
order by COLS_NO_COMMENT desc, v.TABLE_NAME
        );
