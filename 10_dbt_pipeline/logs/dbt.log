  UNION ALL SELECT BUDGET_ITEM_DK,BUDGET_YEAR,BUDGET_PROCEDURE,DVLP_INBOUND_PATH,BDGT_UNIT_NM,2,YEAR_BDGT_AMT_2,CHN_BDGT_AMT_2,ADJ_BDGT_AMT_2,EXEC_AMT_2,YEAR_TXT FROM B
  UNION ALL SELECT BUDGET_ITEM_DK,BUDGET_YEAR,BUDGET_PROCEDURE,DVLP_INBOUND_PATH,BDGT_UNIT_NM,3,YEAR_BDGT_AMT_3,CHN_BDGT_AMT_3,ADJ_BDGT_AMT_3,EXEC_AMT_3,YEAR_TXT FROM B
