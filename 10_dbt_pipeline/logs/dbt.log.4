    dig.CPM_SRC,
    dig.CPA_SRC,
    dig.DEV_UNIT_PRICE_SRC,
    dig.VTR_SRC,
    -- ── 방송 위성(FAB) — 디지털행은 NULL(원천 부재) · 시간축 4컬럼은 VIDEO 전용 ──
    brc.TIME_BAND,
    brc.CM_POSITION,
    brc.RT_TYPE,
    brc.AD_START_TIME,
    brc.AD_END_TIME,
    brc.BROADCAST_DATE,
    brc.PROGRAM_NM,
    brc.CHANNEL_COMPANY,
    brc.CHANNEL_COMPANY_TYPE,
    brc.SPOT_TYPE,
    brc.DURATION_SEC,
