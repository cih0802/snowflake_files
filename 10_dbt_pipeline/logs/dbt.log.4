ned as (\n\n    select\n\n    {% for i in range(n) %}\n    p{{i}}.generated_number * power(2, {{i}})\n    {% if not loop.last %} + {% endif %}\n    {% endfor %}\n    + 1\n    as generated_number\n\n    from\n\n    {% for i in range(n) %}\n    p as p{{i}}\n    {% if not loop.last %} cross join {% endif %}\n    {% endfor %}\n\n    )\n\n    select *\n    from unioned\n    where generated_number <= {{upper_bound}}\n    order by generated_number\n\n{% endmacro %}', 'depends_on': {'macros': ['macro.dbt.get_powers_of_two']}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [], 'created_at': 1787621848.9829435, 'supported_languages': None}, 'macro.dbt.hash': {'name': 'hash', 'resource_type': 'macro', 'package_name': 'dbt', 'path': 'macros/utils/hash.sql', 'original_file_path': 'macros/utils/hash.sql', 'unique_id': 'macro.dbt.hash', 'macro_sql': "{% macro hash(field) -%}\n  {{ return(adapter.dispatch('hash', 'dbt') (field)) }}\n{%- endmacro %}", 'depends_on': {'macros': ['macro.dbt.default__hash']}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [], 'created_at': 1787621848.9833076, 'supported_languages': None}, 'macro.dbt.default__hash': {'name': 'default__hash', 'resource_type': 'macro', 'package_name': 'dbt', 'path': 'macros/utils/hash.sql', 'original_file_path': 'macros/utils/hash.sql', 'unique_id': 'macro.dbt.default__hash', 'macro_sql': "{% macro default__hash(field) -%}\n    md5(cast({{ field }} as {{ api.Column.translate_type('string') }}))\n{%- endmacro %}", 'depends_on': {'macros': []}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [], 'created_at': 1787621848.9835355, 'supported_langua