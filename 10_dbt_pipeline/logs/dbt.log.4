    NULLIF(NULLIF(s:manual_campaign:source::STRING,'(not set)'),'(direct)'),
    NULLIF(NULLIF(NULLIF(s:manual_campaign:medium::STRING,'(not set)'),'(none)'),'(direct)'))    AS SOURCE_MEDIUM,
