FROM GN_DW.BRONZE_CRM.TD_MS_PSTMTR_LQY_SNDNG WHERE SNDNG_KEY IS NOT NULL GROUP BY SNDNG_KEY
UNION ALL
SELECT SEQ_NO,'SND',SUM(TARGET_CNT),SUM(SEND_CNT),SUM(FAIL_CNT),NULL,
  'CRM','BRONZE_CRM.SND_REQ_MST',CURRENT_TIMESTAMP(),CURRENT_TIMESTAMP(),NULL
FROM GN_DW.BRONZE_CRM.SND_REQ_MST WHERE SEQ_NO IS NOT NULL GROUP BY SEQ_NO
  );
