    COUNT(*)                                     AS NULL_UPI_ROWS,
    COUNT_IF(USER_ID IS NOT NULL)                AS HAS_USER_ID_ROWS
FROM GN_DW.SILVER.BIGQUERY_REFINED_DATA
WHERE (
        (EVENT_DATE between '20240601' and '20240630')
        OR (EVENT_DATE between '20250601' and '20250630')
        OR (EVENT_DATE between '20260601' and '20260630')
    )
  AND USER_PSEUDO_ID IS NULL
  -- 기지 창 제외 (위 「왜 기지 창 밖에서만인가」 참조 · 정본 = 50_dbt_…-013 §O91-C)
  AND NOT (EVENT_DATE BETWEEN '20240605' AND '20240610')
GROUP BY 1
ORDER BY 1
      
    ) dbt_internal_test
