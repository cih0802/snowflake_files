    TRY_TO_DATE(CMPGN_STRT_DE, 'YYYYMMDD')        as CAMPAIGN_OPEN_DATE,
    0                                             as ORG_SK,             -- ⚠️ 센티넬(O10 주관조직 미확정)
    'CRM'                       AS DW_SOURCE_SYSTEM,
    CURRENT_TIMESTAMP()::TIMESTAMP_NTZ       AS DW_LOAD_TS,
