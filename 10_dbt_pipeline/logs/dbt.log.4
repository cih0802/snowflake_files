create or replace  temporary view GN_DW.GOLD.DIM_REASON__dbt_tmp
  
   as (
    -- DIM_REASON: 사유 차원 스캐폴드 (CRM_CODE, Bronze 입고 후 실행)
-- Co-authored with CoCo
-- ⚠️ 사유 코드그룹 필터(CD_ID) 확정 대기 — 현재 전체 코드를 REASON_TYPE=CD_ID 로 스캐폴드.
