    CURRENT_TIMESTAMP()::TIMESTAMP_NTZ       AS DW_UPDATE_TS,
    'a795ea34-0dc7-4d3c-9348-290dc56513ed'                    AS DW_BATCH_ID
from GN_DW.SILVER.AGENCY_AD_BROADCAST_CASE
