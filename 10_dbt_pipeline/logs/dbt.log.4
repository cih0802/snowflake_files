        ("REASON_SK", "REASON_CODE", "REASON_NAME", "REASON_TYPE", "DW_SOURCE_SYSTEM", "DW_LOAD_TS", "DW_UPDATE_TS", "DW_BATCH_ID")
    values
        ("REASON_SK", "REASON_CODE", "REASON_NAME", "REASON_TYPE", "DW_SOURCE_SYSTEM", "DW_LOAD_TS", "DW_UPDATE_TS", "DW_BATCH_ID")

