l\n     {% endif %}\n     and DBT_INTERNAL_SOURCE.dbt_change_type in (\'update\', \'delete\')\n        then update\n        set {{ columns.dbt_valid_to }} = DBT_INTERNAL_SOURCE.{{ columns.dbt_valid_to }}\n\n    when not matched\n     and DBT_INTERNAL_SOURCE.dbt_change_type = \'insert\'\n        then insert ({{ insert_cols_csv }})\n        values ({{ insert_cols_csv }})\n\n{% endmacro %}', 'depends_on': {'macros': ['macro.dbt.get_snapshot_table_column_names', 'macro.dbt.equals']}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [], 'created_at': 1787621848.8959708, 'supported_languages': None}, 'macro.dbt.strategy_dispatch': {'name': 'strategy_dispatch', 'resource_type': 'macro', 'package_name': 'dbt', 'path': 'macros/materializations/snapshots/strategies.sql', 'original_file_path': 'macros/materializations/snapshots/strategies.sql', 'unique_id': 'macro.dbt.strategy_dispatch', 'macro_sql': '{% macro strategy_dispatch(name) -%}\n{% set original_name = name %}\n  {% if \'.\' in name %}\n    {% set package_name, name = name.split(".", 1) %}\n  {% else %}\n    {% set package_name = none %}\n  {% endif %}\n\n  {% if package_name is none %}\n    {% set package_context = context %}\n  {% elif package_name in context %}\n    {% set package_context = context[package_name] %}\n  {% else %}\n    {% set error_msg %}\n        Could not find package \'{{package_name}}\', called with \'{{original_name}}\'\n    {% endset %}\n    {{ exceptions.raise_compiler_error(error_msg | trim) }}\n  {% endif %}\n\n  {%- set search_name = \'snapshot_\' ~ name ~ \'_strategy\' -%}\n\n  {% if search_name not in package_context %}\n    {% set error_msg %}\n        The specified strategy macro \'{{name}}\' was not found in package \'{{ package_name }}\'\n    {% endset %}\n    {{ exceptions.raise_compiler_error(error_msg | trim) }}\n  {% endif %}\n  {{ return(package_context[s