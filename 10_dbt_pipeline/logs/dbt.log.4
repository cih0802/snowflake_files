with src as (
    select distinct SEND_CHANNEL, SNDNG_TY_CD
    from GN_DW.SILVER.CRM_SEND_REQUEST
)

select
    ABS(HASH(COALESCE(CAST(SEND_CHANNEL AS VARCHAR), '∅') || '‖' || COALESCE(CAST(SNDNG_TY_CD AS VARCHAR), '∅'))) as SERVICE_SK,
