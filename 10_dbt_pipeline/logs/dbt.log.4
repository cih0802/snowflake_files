   as (
    -- CRM_SEND_MEMBER_LINK_LOG: 메시지 발송 메일 링크 클릭 로그 정제 (BRONZE SND_MEMBER_MAIL_LINK_LOG → SILVER)
-- Co-authored with CoCo
--
-- ============================================================================
-- [2026-09-16 O162 신설]
-- ----------------------------------------------------------------------------
-- 메일 링크 클릭 세부 로그.
