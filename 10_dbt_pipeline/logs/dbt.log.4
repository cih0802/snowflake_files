with fmm as (
    select REASON_SK, UNPAID_FLAG_EOM, HAS_BILLING
    from GN_DW.GOLD.FACT_MEMBER_MONTHLY
    where HAS_BILLING = TRUE and UNPAID_FLAG_EOM = TRUE
)
select
    COUNT(*) as unmapped_cnt,
    (select COUNT(*) from fmm) as total_unpaid,
