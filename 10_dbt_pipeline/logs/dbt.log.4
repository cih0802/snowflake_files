    -- CRM_BIZ_TARGET: FTG-B 사업목표 — 원천=CRM 확정(2026-07-20, 구 ERP_BIZ_TARGET). CRM 신규 목표 테이블 입고 대기(E-6) 스키마-only 빈 모델(WHERE 1=0).
-- Co-authored with CoCo
-- 단위=건(TARGET_CNT, 지표사전 #152~155). TARGET_TYPE(당초/추경1차/추경2차)로 GOLD ANNUAL/SUPP 분기.
-- 입고 시 SELECT 교체. 08 DDL(SILVER.CRM_BIZ_TARGET) 컬럼/타입과 정합(빈 결과 유지).
SELECT
  CAST(NULL AS VARCHAR)        AS BIZ_TARGET_DK,
  CAST(NULL AS NUMBER(4,0))    AS TARGET_YEAR,
  CAST(NULL AS NUMBER(2,0))    AS MONTH_NO,
  CAST(NULL AS VARCHAR(6))     AS MONTH_KEY,
  CAST(NULL AS VARCHAR)        AS ORG_CD,
  CAST(NULL AS VARCHAR)        AS ORG_NM,
  CAST(NULL AS VARCHAR)        AS SPONSOR_BIZ_NM,
  CAST(NULL AS VARCHAR)        AS CAMPAIGN_NM,
  CAST(NULL AS VARCHAR)        AS TARGET_TYPE,
  CAST(NULL AS NUMBER(18,4))   AS TARGET_CNT,
  CAST('CRM' AS VARCHAR)       AS DW_SOURCE_SYSTEM,
  CAST(NULL AS VARCHAR)        AS DW_SOURCE_TABLE,
  CURRENT_TIMESTAMP()          AS DW_LOAD_TS,
  CAST(NULL AS TIMESTAMP_NTZ)  AS DW_UPDATE_TS,
  CAST(NULL AS VARCHAR)        AS DW_BATCH_ID
WHERE 1=0
  );
