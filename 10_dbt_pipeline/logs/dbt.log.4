LEFT JOIN GN_DW.SILVER.CRM_CODE pt ON pt.CD_ID='MM287' AND pt.DTL_CD_ID = NULLIF(TRIM(s.DSCNTC_PATH),'')
WHERE s.MBER_NO IS NOT NULL AND s.SPNSR_DSCNTC_DE IS NOT NULL AND s.SER_NO IS NOT NULL
  );
