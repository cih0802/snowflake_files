    select * from GN_DW.SILVER.CRM_CODE
)

select
    ABS(HASH(COALESCE(CAST(CD_ID AS VARCHAR), '∅') || '‖' || COALESCE(CAST(DTL_CD_ID AS VARCHAR), '∅')))          as REASON_SK,
    DTL_CD_ID                                     as REASON_CODE,
