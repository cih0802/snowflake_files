--    순번 부여 순서가 무관 → DK **집합**은 재실행 멱등.
WITH src AS (
    SELECT
        TIME                    AS TIME,
        YEAR                    AS YEAR,
        CPR_NM                  AS CPR_NM,
        DMST_OVSEA_DIV_NM       AS DMST_OVSEA_DIV_NM,
