        MATR_NM                 AS MATR_NM,
        CMPGN_TY_NM             AS CMPGN_TY_NM,
        DUR_PD_MATR_CHN         AS DUR_PD_MATR_CHN,
        CHNNL_CMPNY_TY_NM       AS CHNNL_CMPNY_TY_NM,
        WEEK                    AS WEEK,
