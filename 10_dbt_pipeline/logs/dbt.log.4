select
    MONTH_KEY,
    count(*) as VIOLATING_ROWS
from GN_DW.GOLD.FACT_TARGET_MEMBER_DEV
where MONTH_KEY <> 0
  and (
        MONTH_KEY not between 199101 and 203512
     or MOD(MONTH_KEY, 100) not between 1 and 12
      )
group by MONTH_KEY
      
    ) dbt_internal_test
