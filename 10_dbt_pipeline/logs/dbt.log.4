         WHEN g.ID_RESOLUTION = 'DIRECT' THEN 'HIGH'
         ELSE 'MEDIUM' END                                       AS MATCH_CONFIDENCE,
    'GA4+CRM'                       AS DW_SOURCE_SYSTEM,
