insert into GN_DW.SILVER.BIGQUERY_IDENTITY ("USER_PSEUDO_ID", "GA_MEMBER_ID", "ID_SCHEME", "MEMBER_TYPE", "MBER_NO", "ONCE_MBER_NO", "ID_RESOLUTION", "DW_SOURCE_SYSTEM", "DW_SOURCE_TABLE", "DW_LOAD_TS", "DW_UPDATE_TS", "DW_BATCH_ID")
    (
        select "USER_PSEUDO_ID", "GA_MEMBER_ID", "ID_SCHEME", "MEMBER_TYPE", "MBER_NO", "ONCE_MBER_NO", "ID_RESOLUTION", "DW_SOURCE_SYSTEM", "DW_SOURCE_TABLE", "DW_LOAD_TS", "DW_UPDATE_TS", "DW_BATCH_ID"
