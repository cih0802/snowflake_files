    CURRENT_TIMESTAMP()::TIMESTAMP_NTZ       AS DW_UPDATE_TS,
    'fb458d38-82e0-450f-8aa4-5c8a3880b029'                    AS DW_BATCH_ID
from src

union all
-- unknown 멤버(SK=0): 팩트 PAYMENT_SK=0(미매핑) 조인 유실 방지
