create or replace  temporary view GN_DW.SILVER.AGENCY_AD_PERFORMANCE__dbt_tmp
  
   as (
    -- AGENCY_AD_PERFORMANCE: 광고성과 = DIGITAL ∪ REBROADCAST ∪ VIDEO (원천 1행 grain, NULL 패딩), 정본 09 STEP5.
-- Co-authored with CoCo
-- 연·월 = DATE 파생(텍스트 파싱 금지) · _SOURCE_SYSTEM 테이블기반 · 인입콜 TRY_TO_NUMBER · 파생지표 미적재.
SELECT 'DIGITAL' AS SOURCE_SYSTEM, DATE AS AD_DATE, YEAR(DATE) AS AD_YEAR, MONTH(DATE) AS AD_MONTH,
  NULLIF(TRIM(CMPGN_NM),'') AS CAMPAIGN_NM, NULLIF(TRIM(UPPER_CMPGN_NM),'') AS UPPER_CAMPAIGN_NM,
  NULLIF(TRIM(MEDIA_NM),'') AS MEDIA_CHANNEL_NM, NULLIF(TRIM(DEVICE),'') AS DEVICE_NM,
