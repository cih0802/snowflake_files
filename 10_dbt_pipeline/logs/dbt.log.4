create or replace  temporary view GN_DW.SILVER.CRM_PAYMENT_METHOD__dbt_tmp
  
   as (
    -- CRM_PAYMENT_METHOD: 결제수단(현재상태, SETLE_KEY dedup) + 수단명(PM040) 라벨, 정본 09 STEP3.
-- Co-authored with CoCo
SELECT
