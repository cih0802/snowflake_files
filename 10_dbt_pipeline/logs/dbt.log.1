create or replace view GN_DW.GOLD.WIDE_TARGET_DEV
    (
      MONTH_KEY COMMENT $$목표월 YYYYMM$$,
      CAL_YEAR COMMENT $$FLOOR(MONTH_KEY/100) — 연도$$,
      CAL_MONTH COMMENT $$MOD(MONTH_KEY,100) — 월$$,
