    o.DEPARTMENT as ORG_DEPARTMENT, o.TEAM as ORG_TEAM
from GN_DW.GOLD.FACT_TARGET_MEMBER_DEV f
left join GN_DW.GOLD.DIM_ORG o on f.ORG_SK = o.ORG_SK
    );
