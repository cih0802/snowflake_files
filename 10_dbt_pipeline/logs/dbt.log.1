  CURRENT_TIMESTAMP()                 AS DW_UPDATE_TS,
  NULL                                AS DW_BATCH_ID
FROM GN_DW.BRONZE_CRM.SND_MEMBER_MAIL_LINK_LOG
WHERE LOG_SEQ IS NOT NULL
  );
