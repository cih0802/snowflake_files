[0m19:28:30.259012 [debug] [Thread-3 (]: On test.gn_dw_silver.warn_ga4_null_user_pseudo_id_rows: /* {"app": "dbt", "dbt_version": "1.9.4", "profile_name": "default", "target_name": "dev", "node_id": "test.gn_dw_silver.warn_ga4_null_user_pseudo_id_rows"} */
create or replace transient table GN_DW.OPS.warn_ga4_null_user_pseudo_id_rows
         as
        (-- warn_ga4_null_user_pseudo_id_rows: GA4 `USER_PSEUDO_ID` NULL 탈락 행을 **행 단위로 고정**한다.
-- Co-authored with CoCo
--
-- 🆕 🔴🔴 [2026-09-22 O176 · 사용자 결정 B안] `O91-F A1` 의 정면 처방이다.
--   `A1` 판정 = *"`DEC-40` 은 행을 버리면서 격리 테이블을 만들지 않았다 — 감사 불가 설계다.
