--    ⚠️ 이 주석에 마커 문법을 그대로 적으면 Jinja 가 주석 안에서도 파싱해 "tag name expected" 로
--       컴파일이 깨진다(같은 세션에서 실측). 문법은 예시로 적지 않는다.




select
    MONTH_KEY,
    count(*) as VIOLATING_ROWS
from GN_DW.GOLD.FACT_TARGET_MEMBER_DEV
where MONTH_KEY <> 0
  and (
