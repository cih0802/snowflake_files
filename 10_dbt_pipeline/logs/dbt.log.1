  NULL                                 AS DW_BATCH_ID
FROM GN_DW.BRONZE_CRM.TM_MM_FDRM_MBER_SPNSR_BSNS
WHERE SPNSR_NO IS NOT NULL AND SPNSR_BSNS_NO IS NOT NULL
