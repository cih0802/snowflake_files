    c.ACQ_DVLP_DIV_CD                               as ACQ_DVLP_DIV_CD,
    -- ── 획득 시점 회원 속성 (현재 값이 아니다 — O34) ──────────────────────────
    c.ACQ_AGE_CD                                    as ACQ_AGE_CD,
