    CURRENT_TIMESTAMP()::TIMESTAMP_NTZ       AS DW_UPDATE_TS,
    '4ab18564-dd38-4b6b-8187-f89e5180bd7f'                    AS DW_BATCH_ID
from c

union all
-- unknown 멤버(SK=0): 팩트 REASON_SK=0(미매핑) 조인 유실 방지
