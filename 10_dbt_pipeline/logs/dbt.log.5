-- Co-authored with CoCo
-- 의존성(7-C): ref 로 GA4_IDENTITY·CRM_MEMBER 후행 강제. LEFT JOIN(UNMATCHED 보존, C1). CHILD_CODE 제외.

SELECT
    g.USER_PSEUDO_ID    AS USER_PSEUDO_ID,
