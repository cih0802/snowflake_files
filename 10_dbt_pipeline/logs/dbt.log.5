from t
left join GN_DW.GOLD.DIM_ORG o
    on o.ORG_DK = ABS(HASH(t.DEPT_ID))
group by TRY_TO_NUMBER(t.STDR_MT), COALESCE(o.ORG_SK, 0), t.MBER_DVLP_DIV_CD
  );
