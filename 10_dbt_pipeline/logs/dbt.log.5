SELECT DISTINCT
  -- GA4 공식 기준(platform 단독 불가 — PC/모바일 웹 모두 WEB): platform × device.category 조합.
  --   APP = platform IN (ANDROID, IOS) / M = WEB × (mobile|tablet) / PC = WEB × desktop
