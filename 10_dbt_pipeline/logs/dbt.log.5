    'a662e664-deb2-4dea-92c9-0eab6bdf7334'                    AS DW_BATCH_ID
from s

union all
-- unknown 멤버(SK=0): FACT_BUDGET.BUDGET_ITEM_SK 미매핑 조인 유실 방지 센티넬
