        CHNNL_CMPNY_TY_NM       AS CHNNL_CMPNY_TY_NM,
        WEEK                    AS WEEK,
        CONV_CALL_CNT           AS CONV_CALL_CNT,
        BRDC_MT                 AS BRDC_MT,
        YEAR                    AS YEAR,
        CTV_DIV_NM              AS CTV_DIV_NM,
        MKT_CMPGN_NM            AS MKT_CMPGN_NM,
