-- Co-authored with CoCo
--
-- ============================================================================
-- [2026-09-16 O162 신설]
-- ----------------------------------------------------------------------------
-- 메일 링크 클릭 세부 로그.
-- ============================================================================
SELECT
  LOG_SEQ                             AS LOG_SEQ,          -- PK. 로그순번
  REQ_SEQ_NO                          AS REQ_SEQ_NO,       -- 발송요청순번 (→CRM_SEND_REQUEST)
