  s.AGE                             AS AGE,
  -- [2026-08-03 G3] 정본 코드컬럼 raw 전파(라벨 미배선 — 수요 확인 후 별도).
  NULLIF(TRIM(s.MBER_DIV_CD),'')    AS MBER_DIV_CD,   -- MM018
