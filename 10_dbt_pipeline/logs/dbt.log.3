create or replace view GN_DW.GOLD.WIDE_AD_COMBINED
    (
      AD_PERF_DK COMMENT $$행 식별자(GRAIN·PK) MD5(AD_SOURCE_TYPE|ROW_HASH|DUP_SEQ). 위성 3종 조인키. 발급지점=SILVER.AGENCY_AD_ROW_* (DEC-11)$$,
