-- Co-authored with CoCo
SELECT
  NULLIF(TRIM(s.OCCRRNC_DE),'')     AS OCCRRNC_DE,
  s.SER_NO                          AS SER_NO,
  NULLIF(TRIM(s.MBER_NO),'')        AS MBER_NO,
