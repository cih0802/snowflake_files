    ACQ_SPNSR_DIV_CD, ACQ_SPNSR_DIV_NM,
    ACQ_CPR_DIV_CD, ACQ_CPR_DIV_NM,
    ACQ_BRAND, ACQ_PARENT_CAMPAIGN_NAME, ACQ_PROMO_METHOD_NAME,
