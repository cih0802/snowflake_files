    from GN_DW.SILVER.BIGQUERY_TRAFFIC_SOURCE
    group by UTM_SOURCE, UTM_MEDIUM
)

select
    ABS(HASH(COALESCE(CAST(UTM_SOURCE AS VARCHAR), '∅') || '‖' || COALESCE(CAST(UTM_MEDIUM AS VARCHAR), '∅'))) as BIGQUERY_SOURCE_SK,
