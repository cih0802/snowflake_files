  NULLIF(TRIM(s.ACMSLT_DEPT_CD),'') AS ACMSLT_DEPT_CD,
  NULLIF(TRIM(s.CMPGN_CD),'')       AS CMPGN_CD,
  NULLIF(TRIM(s.AREA_CD),'')        AS AREA_CD,
