    mem.SEX                                     as SEX,
    mem.GENDER_NAME                             as GENDER_NAME,
    -- ── 획득 귀속 축 (O45 · LEFT JOIN 필수 — 개발사건 없는 회원 1.61% 존재) ───
    acq.ACQ_CAMPAIGN_SK,
    acq.ACQ_BRAND                               as ACQ_BRAND,
    acq.ACQ_CAMPAIGN_NAME                       as ACQ_CAMPAIGN_NAME,
