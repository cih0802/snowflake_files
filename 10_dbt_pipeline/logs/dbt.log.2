   as (
    -- DIM_SPONSORSHIP: 후원사업 차원 스캐폴드 (CRM_SPONSORSHIP, Bronze 입고 후 실행)
-- Co-authored with CoCo


with s as (
    select * from GN_DW.SILVER.CRM_SPONSORSHIP
)

select
    ABS(HASH(COALESCE(CAST(SPNSR_BSNS_ID AS VARCHAR), '∅')))              as SPONSORSHIP_SK,
