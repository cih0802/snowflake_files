    DVLP_MBER_CNT,                                                          -- O16: 개발회원수(고유 이름으로 분리)
    DVLP_CNT,                                                               -- O16: 개발건수(고유 이름으로 분리)
    CAST(NULL AS FLOAT),                                                    -- AD_VIEW_RT_SRC: 영상 전용
    CAST(NULL AS FLOAT),                                                    -- CPC_SRC: 영상 전용
    'AGENCY',
    'BRONZE_AGENCY.REBRDC_AD_CMPGN_DTLS',
