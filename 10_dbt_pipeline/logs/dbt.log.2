    ABS(HASH(COALESCE(CAST(CMPGN_CD AS VARCHAR), '∅')))                   as CAMPAIGN_SK,
    CMPGN_CD                                      as CAMPAIGN_BK,
    BRND_NM                                       as BRAND,
    UPPER_CMPGN_CD                                as PARENT_CAMPAIGN,
