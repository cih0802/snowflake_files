    select * from GN_DW.SILVER.ERP_BUDGET_ITEM
)

select
    ABS(HASH(COALESCE(CAST(BUDGET_ITEM_DK AS VARCHAR), '∅')))                 as BUDGET_ITEM_SK,
    COALESCE(SUBDTL_ITEM_NM, DTL_ITEM_NM, MOK_NM)     as BUDGET_ITEM_NAME,   -- 세세목명(최하위 우선)
