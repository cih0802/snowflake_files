insert into GN_DW.SILVER.AGENCY_AD_BROADCAST_CASE ("AD_PERF_DK", "CASE_SEQ", "BIZ_DIV", "FAMILY_TYPE", "APPEAL_POINT", "CASE_DIV", "DW_SOURCE_SYSTEM", "DW_SOURCE_TABLE", "DW_LOAD_TS", "DW_UPDATE_TS", "DW_BATCH_ID")
    (
