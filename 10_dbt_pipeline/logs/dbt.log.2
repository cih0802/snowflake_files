    CASE WHEN r.SNDNG_KEY IS NULL THEN 0
         ELSE ABS(HASH(COALESCE(CAST(r.SEND_CHANNEL AS VARCHAR), '∅') || '‖' || COALESCE(CAST(r.SNDNG_TY_CD AS VARCHAR), '∅'))) END  as SERVICE_SK,
