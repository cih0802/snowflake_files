  NULLIF(TRIM(s.SEX),'')            AS SEX,           -- CM013 raw. ⚠️CRM_MEMBER.SEX 는 M/F/U 정규화값 — 동명이의
  NULLIF(TRIM(s.SPNSR_AMT_CD),'')   AS SPNSR_AMT_CD,  -- CM012
  'CRM'                             AS DW_SOURCE_SYSTEM,
