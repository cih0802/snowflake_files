    select * from GN_DW.SILVER.CRM_EVENT
)

select
    ABS(HASH(COALESCE(CAST(EVENT_KEY AS VARCHAR), '∅')))                  as EVENT_SK,
    EVENT_KEY                                     as EVENT_BK,
    EVENT_SOURCE                                  as EVENT_KIND,
    -- [2026-08-03 O27] `ELSE '미상'` 제거 — P31: ELSE 절은 도메인 확장을 조용히 삼킨다.
