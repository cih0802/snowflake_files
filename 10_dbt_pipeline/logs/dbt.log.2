create or replace   view GN_DW.GOLD.WIDE_TARGET_DEV
  
   as (
    -- WIDE_TARGET_DEV: 회원개발 목표 팩트(FTG_D) 평탄화 소비뷰 — ref() 거버넌스 (정본 09_빅테이블 VIEW.md §3.3)
