create or replace  temporary view GN_DW.SILVER.CRM_ORG__dbt_tmp
  
   as (
    -- CRM_ORG: 부서(조직) 마스터 정제 (BRONZE TM_CM_DEPT_INFO → SILVER), 정본 09 STEP3.
-- Co-authored with CoCo
SELECT
