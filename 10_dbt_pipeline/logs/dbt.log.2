FROM GN_DW.BRONZE_CRM.SND_MEMBER_LIST WHERE REQ_SEQ_NO IS NOT NULL AND R_NUM IS NOT NULL
QUALIFY ROW_NUMBER() OVER (PARTITION BY REQ_SEQ_NO, R_NUM ORDER BY SND_DT DESC NULLS LAST)=1
  );
