{
  "question": "26년 9월 기준 활동회원에서 중단가능성이 높은 회원 중 캠페인카테고리(고려인캠페인)을 후원중인 회원 수와 회원번호 명단 상위 10명",
  "result": "The question is clear and I can answer it with the following SQL.\n\nGenerated SQL (ensure the -- Generated by Cortex Analyst comment is included when executing the SQL):\n```sql\nWITH __cc AS (\n  SELECT\n    cmpgn_ctgr_nm,\n    has_member_pred,\n    mber_no,\n    member_churn_grade,\n    sponsor_churn_grade,\n    stdr_mt,\n    member_churn_prob\n  FROM GN_DW.SERVING.ML_CHURN_BY_CMPGN_CTGR_V\n), summary AS (\n  SELECT\n    __cc.stdr_mt AS \"기준월\",\n    COUNT(DISTINCT __cc.mber_no) AS \"활동회원수(명)\",\n    COUNT(DISTINCT CASE WHEN __cc.has_member_pred THEN __cc.mber_no END) AS \"회원 단위 예측 대상 회원수(명)\",\n    COUNT(DISTINCT CASE WHEN __cc.member_churn_grade = '고위험' THEN __cc.mber_no END) AS \"중단 고위험 회원수(명)\"\n  FROM __cc\n  WHERE\n    __cc.stdr_mt = '202609' AND __cc.cmpgn_ctgr_nm = '고려인캠페인'\n  GROUP BY\n    __cc.stdr_mt\n), member_list AS (\n  SELECT\n    __cc.mber_no,\n    ROUND(__cc.member_churn_prob * 100, 2) AS member_churn_prob_pct,\n    __cc.member_churn_grade,\n    __cc.sponsor_churn_grade,\n    COUNT(__cc.cmpgn_ctgr_nm) AS active_sponsor_cnt\n  FROM __cc\n  WHERE\n    __cc.stdr_mt = '202609'\n    AND __cc.cmpgn_ctgr_nm = '고려인캠페인'\n    AND __cc.member_churn_grade = '고위험'\n  GROUP BY\n    __cc.mber_no,\n    __cc.member_churn_prob,\n    __cc.member_churn_grade,\n    __cc.sponsor_churn_grade\n  ORDER BY\n    member_churn_prob_pct DESC NULLS LAST\n  LIMIT 10\n)\nSELECT\n  s.\"기준월\",\n  s.\"활동회원수(명)\",\n  s.\"회원 단위 예측 대상 회원수(명)\",\n  s.\"중단 고위험 회원수(명)\",\n  m.mber_no AS \"회원번호\",\n  m.member_churn_prob_pct AS \"회원 중단확률(%)\",\n  m.member_churn_grade AS \"회원 중단위험 등급\",\n  m.sponsor_churn_grade AS \"후원건 이탈위험 등급\",\n  m.active_sponsor_cnt AS \"활동 약정 수\"\nFROM summary AS s\nCROSS JOIN member_list AS m\nORDER BY\n  m.member_churn_prob_pct DESC NULLS LAST\n -- Generated by Cortex Analyst (request_id: 61fbf404-8606-4786-bc28-03377231ef78)\n;\n```"
}
