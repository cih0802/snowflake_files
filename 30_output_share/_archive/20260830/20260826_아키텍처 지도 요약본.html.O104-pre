        { id: "G_DIM_AD_CREATIVE", label: "DIM_AD_CREATIVE", layer: "GOLD", domain: "AGENCY" },
        { id: "G_FACT_AD_PERF", label: "FACT_AD_PERFORMANCE", layer: "GOLD", domain: "AGENCY" },
        { id: "G_FACT_AD_DGT", label: "FACT_AD_DIGITAL", layer: "GOLD", domain: "AGENCY" },
        { id: "G_FACT_AD_BRD", label: "FACT_AD_BROADCAST", layer: "GOLD", domain: "AGENCY" },
        { id: "G_FACT_AD_CASE", label: "FACT_AD_BROADCAST_CASE", layer: "GOLD", domain: "AGENCY" },
        { id: "G_DIM_MKT_CMP", label: "DIM_MARKETING_CAMPAIGN", layer: "GOLD", domain: "AGENCY" },
        { id: "G_DIM_GA_SRC", label: "DIM_GA_SOURCE", layer: "GOLD", domain: "GA4" },
        { id: "G_DIM_GA_EVT", label: "DIM_GA_EVENT", layer: "GOLD", domain: "GA4" },
        { id: "G_DIM_DEVICE", label: "DIM_DEVICE", layer: "GOLD", domain: "GA4" },
        { id: "G_DIM_GA_ID", label: "DIM_MEMBER_IDENTITY", layer: "GOLD", domain: "GA4" },
        { id: "G_FACT_GA_BEH", label: "FACT_GA_BEHAVIOR", layer: "GOLD", domain: "GA4" },
        { id: "G_DIM_BUDGET_ITEM", label: "DIM_BUDGET_ITEM", layer: "GOLD", domain: "ERP" },
        { id: "G_FACT_BUDGET", label: "FACT_BUDGET", layer: "GOLD", domain: "ERP" },
        { id: "G_FACT_BDGT_YRL", label: "FACT_BUDGET_YEARLY", layer: "GOLD", domain: "ERP" },

        // WIDE / VIEWS (총 14개 서빙 뷰 반영)
        { id: "W_MEMBER_EVT", label: "WIDE_MEMBER_EVENT", layer: "WIDE", domain: "CRM", status: "view" },
        { id: "W_MEMBER_MTH", label: "WIDE_MEMBER_MONTHLY", layer: "WIDE", domain: "CRM", status: "view" },
        { id: "W_MEMBER_FEE", label: "WIDE_MEMBER_FEE", layer: "WIDE", domain: "CRM", status: "view" },
        { id: "W_SVC_EVT", label: "WIDE_SERVICE_EVENT", layer: "WIDE", domain: "CRM", status: "view" },
        { id: "W_EVT_PART", label: "WIDE_EVENT_PARTICIPATION", layer: "WIDE", domain: "CRM", status: "view" },
        { id: "W_TGT_BIZ", label: "WIDE_TARGET_BIZ", layer: "WIDE", domain: "CRM", status: "view" },
        { id: "W_TGT_DEV", label: "WIDE_TARGET_DEV", layer: "WIDE", domain: "CRM", status: "view" },
        { id: "W_AD_COMBINED", label: "WIDE_AD_COMBINED", layer: "WIDE", domain: "AGENCY", status: "view" },
        { id: "W_AD_PERF", label: "WIDE_AD_PERFORMANCE", layer: "WIDE", domain: "AGENCY", status: "view" },
        { id: "W_AD_DGT", label: "WIDE_AD_DIGITAL", layer: "WIDE", domain: "AGENCY", status: "view" },
        { id: "W_AD_BRD", label: "WIDE_AD_BROADCAST", layer: "WIDE", domain: "AGENCY", status: "view" },
        { id: "W_AD_BRD_CASE", label: "WIDE_AD_BROADCAST_CASE", layer: "WIDE", domain: "AGENCY", status: "view" },
        { id: "W_GA_BEH", label: "WIDE_GA_BEHAVIOR", layer: "WIDE", domain: "GA4", status: "view" },
        { id: "W_BUDGET", label: "WIDE_BUDGET", layer: "WIDE", domain: "ERP", status: "view" }
    ];
const columnsData = {
        "B_MBER_INFO": [
            { name: "MBER_NO", type: "VARCHAR2(20)", pk: true, fk: false, desc: "회원번호 (PK)" },
            { name: "MBER_NM", type: "VARCHAR2(100)", pk: false, fk: false, desc: "회원명" },
            { name: "SEX_CD", type: "VARCHAR2(10)", pk: false, fk: false, desc: "성별코드" },
            { name: "BRTHDY", type: "VARCHAR2(8)", pk: false, fk: false, desc: "생년월일" },
            { name: "EML_ADDR", type: "VARCHAR2(200)", pk: false, fk: false, desc: "이메일주소" },
            { name: "MBER_STAT_CD", type: "VARCHAR2(10)", pk: false, fk: false, desc: "회원상태코드" },
            { name: "REG_DT", type: "TIMESTAMP", pk: false, fk: false, desc: "등록일시" }
        ],
        "S_CRM_MEMBER": [
            { name: "MEMBER_DK", type: "VARCHAR", pk: true, fk: false, desc: "회원 통합 대리키" },
            { name: "MEMBER_TYPE", type: "VARCHAR", pk: false, fk: false, desc: "회원 유형" },
            { name: "MBER_NO", type: "VARCHAR", pk: false, fk: false, desc: "회원번호" },
            { name: "SEX", type: "VARCHAR", pk: false, fk: false, desc: "성별 코드" },
            { name: "SEX_NM", type: "VARCHAR", pk: false, fk: false, desc: "성별 명칭" },
            { name: "MBER_STAT_CD", type: "VARCHAR", pk: false, fk: false, desc: "회원 상태 코드" },
            { name: "DBS_INSERT_TIMESTAMP", type: "TIMESTAMP", pk: false, fk: false, desc: "데이터 적재 일시" }
        ],
        "G_DIM_MEMBER": [
            { name: "MEMBER_SK", type: "NUMBER", pk: true, fk: false, desc: "회원 서러게이트 키" },
            { name: "MEMBER_DK", type: "VARCHAR", pk: false, fk: false, desc: "회원 자연키/대리키" },
            { name: "MBER_NM", type: "VARCHAR", pk: false, fk: false, desc: "회원 성명" },
            { name: "SEX_NM", type: "VARCHAR", pk: false, fk: false, desc: "성별 명칭" },
            { name: "AGE_GROUP", type: "VARCHAR", pk: false, fk: false, desc: "연령대" },
            { name: "EFFECTIVE_START_DATE", type: "DATE", pk: false, fk: false, desc: "SCD Type 2 시작일" },
            { name: "EFFECTIVE_END_DATE", type: "DATE", pk: false, fk: false, desc: "SCD Type 2 종료일" }
        ],
        "W_MEMBER_EVT": [
            { name: "MEMBER_EVENT_DK", type: "VARCHAR", pk: true, fk: false, desc: "회원 이벤트 대리키" },
            { name: "MEMBER_SK", type: "NUMBER", pk: false, fk: true, desc: "회원 SK" },
            { name: "EVENT_DATE_SK", type: "NUMBER", pk: false, fk: true, desc: "이벤트일자 SK" },
            { name: "CAMPAIGN_SK", type: "NUMBER", pk: false, fk: true, desc: "캠페인 SK" },
            { name: "EVENT_TYPE_NM", type: "VARCHAR", pk: false, fk: false, desc: "이벤트 유형 명칭" },
            { name: "EVENT_AMT", type: "NUMBER", pk: false, fk: false, desc: "이벤트 금액" }
        ],
        "W_AD_COMBINED": [
            { name: "AD_PERF_DK", type: "VARCHAR", pk: true, fk: false, desc: "광고 성과 대리키" },
            { name: "PERF_DATE_SK", type: "NUMBER", pk: false, fk: true, desc: "실적일자 SK" },
            { name: "CAMPAIGN_SK", type: "NUMBER", pk: false, fk: true, desc: "캠페인 SK" },
            { name: "AD_COST", type: "NUMBER", pk: false, fk: false, desc: "광고 비용" },
            { name: "IMPRESSIONS", type: "NUMBER", pk: false, fk: false, desc: "노출 수" },
            { name: "CLICKS", type: "NUMBER", pk: false, fk: false, desc: "클릭 수" }
        ]
    };
const linksData = [
        { from: "B_MBER_INFO", to: "S_CRM_MEMBER" },
        { from: "S_CRM_MEMBER", to: "G_DIM_MEMBER" },
        { from: "G_DIM_MEMBER", to: "W_MEMBER_EVT" },
        { from: "B_DGT_AD", to: "S_AGN_ROW_DGT" },
        { from: "S_AGN_ROW_DGT", to: "G_FACT_AD_PERF" },
        { from: "G_FACT_AD_PERF", to: "W_AD_COMBINED" },
        { from: "B_GA4_REF", to: "S_GA4_BASIC" },
        { from: "S_GA4_BASIC", to: "G_FACT_GA_BEH" },
        { from: "G_FACT_GA_BEH", to: "W_GA_BEH" },
        { from: "B_BDGT", to: "S_ERP_BUDGET" },
        { from: "S_ERP_BUDGET", to: "G_FACT_BUDGET" },
        { from: "G_FACT_BUDGET", to: "W_BUDGET" }
    ];

    const container = document.getElementById("map-container");
    const svg = document.getElementById("line-svg");

    layers.forEach(layer => {
        const layerEl = document.createElement("div");
        layerEl.className = "layer";
        layerEl.innerHTML = `<div class="layer-title">${layer.title}</div>`;
        
        domains.forEach(domain => {
            const domainNodes = nodesData.filter(n => n.layer === layer.id && n.domain === domain);
            if(domainNodes.length > 0) {
                const groupEl = document.createElement("div");
                groupEl.className = "domain-group";
                groupEl.innerHTML = `<div class="domain-title">${domain}</div>`;
                
                const chipsEl = document.createElement("div");
                chipsEl.className = "chip-container";
                
                domainNodes.forEach(node => {
                    const chip = document.createElement("div");
                    chip.className = `chip ${node.status ? 'status-' + node.status : ''}`;
                    chip.id = `node-${node.id}`;
                    chip.innerText = node.label;
                    chip.onclick = () => selectNode(node.id);
                    chip.onmouseenter = () => highlightLineage(node.id);
                    chip.onmouseleave = () => resetLineage();
                    chipsEl.appendChild(chip);
                });
                groupEl.appendChild(chipsEl);
                layerEl.appendChild(groupEl);
            }
        });
        container.appendChild(layerEl);
    });

    let svgPaths = [];

    function drawLines() {
        svg.innerHTML = '';
        svgPaths = [];
        const svgRect = svg.getBoundingClientRect();
        
        linksData.forEach(link => {
            const elFrom = document.getElementById(`node-${link.from}`);
            const elTo = document.getElementById(`node-${link.to}`);
            
            if(elFrom && elTo) {
                const rectFrom = elFrom.getBoundingClientRect();
                const rectTo = elTo.getBoundingClientRect();
                
                const x1 = rectFrom.right - svgRect.left;
                const y1 = rectFrom.top + (rectFrom.height / 2) - svgRect.top;
                const x2 = rectTo.left - svgRect.left;
                const y2 = rectTo.top + (rectTo.height / 2) - svgRect.top;
                
                const dx = Math.max(Math.abs(x2 - x1) / 2, 25);
                const pathD = `M ${x1} ${y1} C ${x1 + dx} ${y1}, ${x2 - dx} ${y2}, ${x2} ${y2}`;
                
                const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
                path.setAttribute("d", pathD);
                path.setAttribute("class", "lineage");
                path.dataset.from = link.from;
                path.dataset.to = link.to;
                svg.appendChild(path);
                svgPaths.push(path);
            }
        });
    }

    function highlightLineage(nodeId) {
        const getUpstream = (id, acc = new Set()) => {
            linksData.filter(l => l.to === id).forEach(l => { if(!acc.has(l.from)) { acc.add(l.from); getUpstream(l.from, acc); } });
            return acc;
        };
        const getDownstream = (id, acc = new Set()) => {
            linksData.filter(l => l.from === id).forEach(l => { if(!acc.has(l.to)) { acc.add(l.to); getDownstream(l.to, acc); } });
            return acc;
        };

        const upSet = getUpstream(nodeId);
        const downSet = getDownstream(nodeId);

        document.querySelectorAll('.chip').forEach(chip => {
            const id = chip.id.replace('node-', '');
            if(id === nodeId) chip.classList.add('active');
            else if(upSet.has(id)) chip.classList.add('upstream');
            else if(downSet.has(id)) chip.classList.add('downstream');
            else chip.style.opacity = '0.25';
        });

        svgPaths.forEach(path => {
            const from = path.dataset.from;
            const to = path.dataset.to;
            if(to === nodeId || (upSet.has(to) && upSet.has(from))) {
                path.classList.add('upstream-line');
                path.style.opacity = '1';
            } else if(from === nodeId || (downSet.has(from) && downSet.has(to))) {
                path.classList.add('downstream-line');
                path.style.opacity = '1';
            } else {
                path.style.opacity = '0.04';
            }
        });
    }

    function resetLineage() {
        document.querySelectorAll('.chip').forEach(chip => {
            chip.classList.remove('active', 'upstream', 'downstream');
            chip.style.opacity = '1';
        });
        svgPaths.forEach(path => {
            path.classList.remove('upstream-line', 'downstream-line');
            path.style.opacity = '0.15';
        });
    }

    function selectNode(nodeId) {
        const node = nodesData.find(n => n.id === nodeId);
        if(!node) return;
        
        document.getElementById("panel-title").innerText = node.label;
        document.getElementById("panel-subtitle").innerText = `${node.layer} 레이어 / ${node.domain} 도메인`;
        
        const tbody = document.getElementById("panel-content-body");
        tbody.innerHTML = '';
        
        let cols = columnsData[nodeId];
        if(!cols) {
            cols = [
                { name: `${node.label}_SK`, type: "NUMBER", pk: true, fk: false, desc: "서러게이트 대리키" },
                { name: "BUSINESS_ID", type: "VARCHAR", pk: false, fk: false, desc: "비즈니스 식별키" },
                { name: "STATUS_CD", type: "VARCHAR", pk: false, fk: false, desc: "상태 코드" },
                { name: "DBS_INSERT_TIMESTAMP", type: "TIMESTAMP", pk: false, fk: false, desc: "적재 일시" }
            ];
        }

        cols.forEach(col => {
            const tr = document.createElement("tr");
            let badges = "";
            if(col.pk) badges += `<span class="badge pk">PK</span>`;
            if(col.fk) badges += `<span class="badge fk">FK</span>`;
            if(!col.pk && !col.fk) badges += `<span class="badge attr">ATTR</span>`;
            
            tr.innerHTML = `<td>${badges} ${col.name}</td><td class="type-col">${col.type}</td><td>${col.desc}</td>`;
            tbody.appendChild(tr);
        });

        document.getElementById("side-panel").classList.add("open");
    }

    function closePanel() {
        document.getElementById("side-panel").classList.remove("open");
    }

    window.onload = drawLines;
    window.onresize = drawLines;
</script>
</body>
</html>