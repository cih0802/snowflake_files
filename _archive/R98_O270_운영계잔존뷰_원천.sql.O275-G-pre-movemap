-- Q01 정의 원문(원천 판정 1차 근거)
SELECT 'DIM_MEMBER_CURRENT' AS OBJ, GET_DDL('VIEW', 'GN_DW.SERVING.DIM_MEMBER_CURRENT') AS DDL
UNION ALL SELECT 'DIM_MONTH', GET_DDL('VIEW', 'GN_DW.SERVING.DIM_MONTH')
UNION ALL SELECT 'FACT_AD_COMBINED', GET_DDL('VIEW', 'GN_DW.SERVING.FACT_AD_COMBINED')
UNION ALL SELECT 'ML_LTV_SCORE_V', GET_DDL('VIEW', 'GN_DW.SERVING.ML_LTV_SCORE_V');

-- Q02 상류 재귀 리니지(BRONZE_* 도달 스키마 = 원천 · 깊이 10)
WITH RECURSIVE dep (ROOT, LVL, REF_DB, REF_SCHEMA, REF_NAME, REF_DOMAIN) AS (
  SELECT REFERENCING_OBJECT_NAME, 1,
         REFERENCED_DATABASE, REFERENCED_SCHEMA, REFERENCED_OBJECT_NAME, REFERENCED_OBJECT_DOMAIN
  FROM SNOWFLAKE.ACCOUNT_USAGE.OBJECT_DEPENDENCIES
  WHERE REFERENCING_DATABASE = 'GN_DW' AND REFERENCING_SCHEMA = 'SERVING'
    AND REFERENCING_OBJECT_NAME IN ('DIM_MEMBER_CURRENT', 'DIM_MONTH', 'FACT_AD_COMBINED', 'ML_LTV_SCORE_V')
  UNION ALL
  SELECT d.ROOT, d.LVL + 1,
         o.REFERENCED_DATABASE, o.REFERENCED_SCHEMA, o.REFERENCED_OBJECT_NAME, o.REFERENCED_OBJECT_DOMAIN
  FROM dep d
  JOIN SNOWFLAKE.ACCOUNT_USAGE.OBJECT_DEPENDENCIES o
    ON o.REFERENCING_DATABASE = d.REF_DB AND o.REFERENCING_SCHEMA = d.REF_SCHEMA
   AND o.REFERENCING_OBJECT_NAME = d.REF_NAME
  WHERE d.LVL < 10
)
SELECT ROOT, MIN(LVL) AS MIN_LVL, REF_DB, REF_SCHEMA, REF_NAME, REF_DOMAIN
FROM dep
GROUP BY ROOT, REF_DB, REF_SCHEMA, REF_NAME, REF_DOMAIN
ORDER BY ROOT, MIN_LVL, REF_SCHEMA, REF_NAME;

-- Q03 최근 30일 사용자(누가 쓰나 · 0 이면 DROP 후보)
SELECT f.value:"objectName"::STRING AS OBJ, q.ROLE_NAME, q.USER_NAME,
       COUNT(DISTINCT a.QUERY_ID) AS QUERY_CNT, MAX(a.QUERY_START_TIME) AS LAST_TS
FROM SNOWFLAKE.ACCOUNT_USAGE.ACCESS_HISTORY a
JOIN SNOWFLAKE.ACCOUNT_USAGE.QUERY_HISTORY q ON q.QUERY_ID = a.QUERY_ID
, LATERAL FLATTEN(a.DIRECT_OBJECTS_ACCESSED) f
WHERE a.QUERY_START_TIME >= DATEADD(DAY, -30, CURRENT_TIMESTAMP())
  AND f.value:"objectName"::STRING IN ('GN_DW.SERVING.DIM_MEMBER_CURRENT', 'GN_DW.SERVING.DIM_MONTH',
                                       'GN_DW.SERVING.FACT_AD_COMBINED', 'GN_DW.SERVING.ML_LTV_SCORE_V')
GROUP BY 1, 2, 3
ORDER BY 1, QUERY_CNT DESC;

-- Q04 하류 = 이 뷰를 참조하는 객체(SV base 포함 · 0 이면 SV·뷰 영향 없음)
SELECT REFERENCED_OBJECT_NAME AS OBJ,
       REFERENCING_DATABASE, REFERENCING_SCHEMA, REFERENCING_OBJECT_NAME, REFERENCING_OBJECT_DOMAIN
FROM SNOWFLAKE.ACCOUNT_USAGE.OBJECT_DEPENDENCIES
WHERE REFERENCED_DATABASE = 'GN_DW' AND REFERENCED_SCHEMA = 'SERVING'
  AND REFERENCED_OBJECT_NAME IN ('DIM_MEMBER_CURRENT', 'DIM_MONTH', 'FACT_AD_COMBINED', 'ML_LTV_SCORE_V')
ORDER BY 1, 3, 4;

-- Q05 SV 목록(Q04 가 SV 를 못 잡는 경우 대조용 · base 는 DESCRIBE 로 개별 확인)
SHOW SEMANTIC VIEWS IN SCHEMA GN_DW.SERVING;

-- Q06 4개 뷰의 소유자·생성일·현 GRANT
SELECT TABLE_NAME, TABLE_OWNER, CREATED, LAST_ALTERED
FROM GN_DW.INFORMATION_SCHEMA.TABLES
WHERE TABLE_SCHEMA = 'SERVING'
  AND TABLE_NAME IN ('DIM_MEMBER_CURRENT', 'DIM_MONTH', 'FACT_AD_COMBINED', 'ML_LTV_SCORE_V');
SHOW GRANTS ON VIEW GN_DW.SERVING.DIM_MEMBER_CURRENT;
SHOW GRANTS ON VIEW GN_DW.SERVING.DIM_MONTH;
SHOW GRANTS ON VIEW GN_DW.SERVING.FACT_AD_COMBINED;
SHOW GRANTS ON VIEW GN_DW.SERVING.ML_LTV_SCORE_V;

-- Q07 [Q09 영향] GOLD.FACT_MKTG_CAMPAIGN_MONTHLY_COST(소유자 ACCOUNTADMIN) 에 대한 최근 30일 dbt 쓰기 성공·실패
SELECT q.ROLE_NAME, q.QUERY_TYPE, q.EXECUTION_STATUS, q.ERROR_CODE,
       COUNT(*) AS N, MAX(q.START_TIME) AS LAST_TS, ANY_VALUE(LEFT(q.ERROR_MESSAGE, 300)) AS ERR_SAMPLE
FROM SNOWFLAKE.ACCOUNT_USAGE.QUERY_HISTORY q
WHERE q.START_TIME >= DATEADD(DAY, -30, CURRENT_TIMESTAMP())
  AND q.QUERY_TEXT ILIKE '%FACT_MKTG_CAMPAIGN_MONTHLY_COST%'
  AND q.QUERY_TYPE IN ('INSERT', 'TRUNCATE_TABLE', 'MERGE', 'DELETE', 'ALTER_TABLE_ADD_COLUMN', 'ALTER_TABLE_MODIFY_COLUMN', 'ALTER')
GROUP BY 1, 2, 3, 4
ORDER BY LAST_TS DESC;

-- Q08 [Q09 영향] 그 테이블의 현 GRANT(dbt 역할이 INSERT·TRUNCATE 권한을 갖는가)
SHOW GRANTS ON TABLE GN_DW.GOLD.FACT_MKTG_CAMPAIGN_MONTHLY_COST;

